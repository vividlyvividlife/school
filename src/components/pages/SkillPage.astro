---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteCopy, type Lang } from '../../i18n/site';
import { skillCommon, skillCopy, type SkillId } from '../../i18n/skills';
import '../../styles/trainer.css';
import '../../styles/vivid-trainer.css';
import '../../styles/skills.css';

interface Props {
  lang: Lang;
  skill: SkillId;
}

const { lang, skill } = Astro.props;
const p = skillCopy[lang][skill];
const sc = skillCommon[lang];
const t = siteCopy[lang].trainer;
const B = import.meta.env.BASE_URL;
const asset = (path: string) => B.replace(/\/+$/, '') + '/' + path.replace(/^\/+/, '');
const jsVersion = Date.now().toString(36);
const isCompare = skill === 'compare';
const isBrackets = skill === 'brackets';
const isProblems = skill === 'problems';
const isOperations = skill === 'operations';
const hasOps = isBrackets || isProblems || isOperations;
const defaults: Record<SkillId, { from: number; to: number }> = {
  digits: { from: 10, to: 99 },
  compare: { from: 1, to: 100 },
  brackets: { from: 1, to: 100 },
  units: { from: 1, to: 100 },
  perimeter: { from: 1, to: 20 },
  problems: { from: 10, to: 100 },
  polylines: { from: 1, to: 10 },
  equations: { from: 1, to: 100 },
  remainders: { from: 10, to: 100 },
  area: { from: 1, to: 10 },
  operations: { from: 1, to: 20 },
  divisibility: { from: 1, to: 50 },
  geometry: { from: 1, to: 20 },
  thousand: { from: 100, to: 999 },
  round: { from: 1, to: 50 },
  tree: { from: 2, to: 5 }
};
const d = defaults[skill];
const toMax = skill === 'digits' ? 99 : (skill === 'perimeter' || skill === 'polylines' || skill === 'area' || skill === 'geometry') ? 20
  : skill === 'units' ? 10000 : skill === 'thousand' ? 999 : skill === 'round' ? 99 : skill === 'tree' ? 6 : 100;
const slugRu: Record<SkillId, string> = {
  digits: 'razryady', compare: 'sravnenie',
  brackets: 'skobki', units: 'velichiny', perimeter: 'perimetr',
  problems: 'zadachi', polylines: 'lomanye',
  equations: 'uravneniya', remainders: 'delenie-s-ostatkom',
  area: 'ploshchad-i-obem', operations: 'operacii-i-algoritmy',
  divisibility: 'delimost',
  geometry: 'geometriya', thousand: 'tysyacha',
  round: 'kruglye-chisla', tree: 'derevo-vozmozhnostey'
};
const slugEn: Record<SkillId, string> = {
  digits: 'place-value', compare: 'comparison',
  brackets: 'brackets', units: 'units', perimeter: 'perimeter',
  problems: 'word-problems', polylines: 'polylines',
  equations: 'equations', remainders: 'remainders',
  area: 'area-and-volume', operations: 'operations-and-algorithms',
  divisibility: 'divisibility',
  geometry: 'geometry', thousand: 'three-digit-numbers',
  round: 'round-numbers', tree: 'tree-of-possibilities'
};
const slug = lang === 'en' ? slugEn[skill] : slugRu[skill];
const offlineFile = lang === 'en' ? `offline/en-${slug}.html` : `offline/${slug}.html`;
const downloadName = `${slug}.html`;
const taskEntries = Object.entries(p.tasks);
---

<BaseLayout title={p.meta.title} description={p.meta.description} keywords={p.meta.keywords} page="trainer" lang={lang}>
<section id="setup" class="screen active" data-skill={skill} data-lang={lang}>
  <div class="wrap">
    <h1>{p.h1}</h1>
    <p class="sub">{p.sub}</p>

    <div class="v-setup">
      <section class="v-section v-counted">
        <header class="v-head">
          <span class="v-num"></span>
          <div><h2>{sc.rangeTitle}</h2><p>{p.rangeHint}</p></div>
        </header>
        <div class="v-range">
          <div class="v-stepper-field">
            <span class="v-field-label">{t.from}</span>
            <div class="v-stepper">
              <button type="button" class="v-step" data-target="from" data-step="-1" aria-label="−">−</button>
              <input id="from" class="v-num-input" type="number" inputmode="numeric" min="0" max={toMax} step="1" value={d.from}>
              <button type="button" class="v-step" data-target="from" data-step="1" aria-label="+">+</button>
            </div>
          </div>
          <div class="v-stepper-field">
            <span class="v-field-label">{t.to}</span>
            <div class="v-stepper">
              <button type="button" class="v-step" data-target="to" data-step="-1" aria-label="−">−</button>
              <input id="to" class="v-num-input" type="number" inputmode="numeric" min="1" max={toMax} step="1" value={d.to}>
              <button type="button" class="v-step" data-target="to" data-step="1" aria-label="+">+</button>
            </div>
          </div>
        </div>
        <div class="chips" id="toChips">
          {p.chips.map((v) => <button type="button" data-v={v}>{v}</button>)}
        </div>
      </section>

      {taskEntries.length > 0 && (
        <section class="v-section v-counted">
          <header class="v-head">
            <span class="v-num"></span>
            <div><h2>{sc.tasksTitle}</h2><p>{sc.tasksHint}</p></div>
          </header>
          <div class="seg multi types-seg v-tasks-grid" data-key="types">
            {taskEntries.map(([key, label]) => <button type="button" data-v={key}>{label}</button>)}
          </div>
        </section>
      )}

      {hasOps && (
        <section class="v-section v-counted">
          <header class="v-head">
            <span class="v-num"></span>
            <div><h2>{isProblems ? t.actionsProblems : t.actions}</h2><p>{isProblems ? t.actionsHintProblems : t.actionsHint}</p></div>
          </header>
          <div class="seg multi ops-seg v-ops" data-key="ops" data-multi="1">
            <button type="button" data-v="add" title={t.addTitle}><span class="v-op-symbol">+</span><span class="v-op-label">{t.addTitle}</span></button>
            <button type="button" data-v="sub" title={t.subTitle}><span class="v-op-symbol">−</span><span class="v-op-label">{t.subTitle}</span></button>
            <button type="button" data-v="mul" title={t.mulTitle}><span class="v-op-symbol">×</span><span class="v-op-label">{t.mulTitle}</span></button>
            <button type="button" data-v="div" title={t.divTitle}><span class="v-op-symbol">÷</span><span class="v-op-label">{t.divTitle}</span></button>
          </div>
          {isProblems && (
            <div class="v-star-row">
              <button type="button" id="starBtn" class="star-toggle v-star-toggle" aria-pressed="false" title={t.starTitle}>
                <svg class="star-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6l2.98 6.04 6.66.97-4.82 4.7 1.14 6.63L12 17.8l-5.96 3.14 1.14-6.63-4.82-4.7 6.66-.97z"/></svg>
                <span>{t.starLabel}</span>
              </button>
              <div class="hint">{t.starHint}</div>
            </div>
          )}
        </section>
      )}

      {!isCompare && (
        <section class="v-section v-counted">
          <header class="v-head">
            <span class="v-num"></span>
            <div><h2>{t.answerWith}</h2></div>
          </header>
          <div class="seg answer-seg v-answer-grid" data-key="answer">
            <button type="button" data-v="type"><span class="v-ans-preview"><i>7</i><i>8</i><i>9</i></span><span class="v-ans-title">{t.answerType}</span></button>
            <button type="button" data-v="tiles6"><span class="v-ans-preview"><i>6</i></span><span class="v-ans-title">{t.answerTiles6}</span></button>
            <button type="button" data-v="tiles9"><span class="v-ans-preview"><i>9</i></span><span class="v-ans-title">{t.answerTiles9}</span></button>
            <button type="button" data-v="tiles12"><span class="v-ans-preview"><i>12</i></span><span class="v-ans-title">{t.answerTiles12}</span></button>
          </div>
        </section>
      )}

      {isCompare && (
        <section class="v-section v-counted">
          <header class="v-head">
            <span class="v-num"></span>
            <div><h2>{t.answerWith}</h2><p>{sc.signHint}</p></div>
          </header>
          <div class="v-sign-row" aria-hidden="true">
            <span><b>&lt;</b><i>{sc.signLess}</i></span>
            <span><b>=</b><i>{sc.signEqual}</i></span>
            <span><b>&gt;</b><i>{sc.signMore}</i></span>
          </div>
        </section>
      )}

      <section class="v-section v-counted">
        <header class="v-head">
          <span class="v-num"></span>
          <div><h2>{t.mode}</h2></div>
        </header>
        <div class="seg mode-seg v-seg" data-key="mode">
          <button type="button" data-v="free">{t.modeFree}</button>
          <button type="button" data-v="timed">{t.modeTimed}</button>
        </div>
        <div class="v-time" id="timeRow">
          <span class="v-field-label">{t.duration}</span>
          <span class="numitem"><input id="min" class="v-num-input" type="number" inputmode="numeric" min="0" max="300" value="2"> <span class="dim">{t.minUnit}</span></span>
          <span class="numitem"><input id="sec" class="v-num-input" type="number" inputmode="numeric" min="0" max="59" value="0"> <span class="dim">{t.secUnit}</span></span>
        </div>
      </section>

      <details class="v-section v-more">
        <summary class="v-more-summary">
          <span class="v-num">🔔</span>
          <div><h2>{t.sound}</h2><p>{t.soundHint}</p></div>
          <span class="v-chev" aria-hidden="true">⌄</span>
        </summary>
        <div class="v-more-body">
          <div class="sound-row">
            <label class="switch v-switch">
              <input id="sound" type="checkbox" checked>
              <span class="track"></span>
              <span>{t.soundLabel}</span>
            </label>
            <button id="soundTest" class="btn small" type="button">{t.soundTest}</button>
          </div>
        </div>
      </details>

      <section class="v-section v-hard">
        <header class="v-head">
          <span class="v-num">🌱</span>
          <div><h2>{t.hardTitle}</h2><p id="hardInfo">{t.hardInfo}</p></div>
        </header>
        <div id="hardList" class="exlist" hidden></div>
        <div class="hard-actions">
          <button id="hardBtn" class="btn" type="button" disabled>{t.hardBtn}</button>
          <button id="clearHard" class="btn small" type="button" hidden>{t.clearHard}</button>
        </div>
      </section>

      <section class="v-section v-history">
        <header class="v-head">
          <span class="v-num">📜</span>
          <div><h2>{t.history}</h2></div>
        </header>
        <div id="histList" class="hist"></div>
        <button id="clearHist" class="btn small" type="button">{t.clear}</button>
      </section>
    </div>

    <div class="v-startbar">
      <div class="v-startbar-inner">
        <div class="v-start-info">
          <div class="v-start-kicker">{t.setTitle}</div>
          <div class="hint" id="poolInfo">{sc.poolPrefix}…</div>
          <a class="v-offline" href={asset(offlineFile)} download={downloadName} title={t.offlineTitle} data-offline-hide>{t.offline}</a>
        </div>
        <button id="startBtn" class="btn primary v-start-btn" type="button">{t.start}</button>
      </div>
    </div>
  </div>
</section>

<section id="game" class="screen">
  <div class="gbar">
    <button id="stopBtn" class="btn" type="button">{t.stop}</button>
    <button id="pauseBtn" class="btn pause-btn" type="button" aria-pressed="false" hidden data-pause={t.pause} data-resume={t.resume}>{t.pause}</button>
    <button id="skipBtn" class="btn skip-btn" type="button">{t.skip}</button>
    <div class="gmeta" id="gInfo"></div>
    <div class="score"><span class="ok" id="scoreOk">0</span><span class="sep">·</span><span class="bad" id="scoreBad">0</span></div>
  </div>
  <div class="timewrap" id="timeWrap">
    <div class="tbar"><div class="tfill" id="tfill"></div></div>
    <div class="tclock" id="tclock">{t.time}</div>
  </div>
  <div class="playarea">
    <div class="playgroup">
      <div class="eqwrap" id="eqw">
        <div class="eq" id="eq"></div>
        <div class="cap" id="cap"></div>
        <details class="sk-acc" id="figWrap" hidden>
          <summary id="figSummary">{sc.figShow}</summary>
          <div class="sk-fig" id="fig"></div>
        </details>
      </div>
      <div class="padwrap">
        <div class="signpad" id="signpad" hidden>
          <button type="button" data-s="&lt;" aria-label="меньше">&lt;</button>
          <button type="button" data-s="=" aria-label="равно">=</button>
          <button type="button" data-s="&gt;" aria-label="больше">&gt;</button>
        </div>
        <div class="pad tiles" id="tiles" hidden></div>
        <div class="pad" id="pad">
          <button type="button" data-k="1">1</button>
          <button type="button" data-k="2">2</button>
          <button type="button" data-k="3">3</button>
          <button type="button" data-k="4">4</button>
          <button type="button" data-k="5">5</button>
          <button type="button" data-k="6">6</button>
          <button type="button" data-k="7">7</button>
          <button type="button" data-k="8">8</button>
          <button type="button" data-k="9">9</button>
          <button type="button" data-k="del" class="del">⌫</button>
          <button type="button" data-k="0">0</button>
          <button type="button" data-k="ok" class="ok">OK</button>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="results" class="screen">
  <div class="wrap">
    <h2 id="resTitle">{t.resTitle}</h2>
    <div class="verdict" id="verdict"></div>
    <div class="stats">
      <div class="stat good"><span class="tico" aria-hidden="true">✅</span><b id="rOk">0</b><span>{t.rOk}</span></div>
      <div class="stat bad"><span class="tico" aria-hidden="true">❌</span><b id="rBad">0</b><span>{t.rBad}</span></div>
      <div class="stat skip"><span class="tico" aria-hidden="true">⏭️</span><b id="rSkip">0</b><span>{t.rSkip}</span></div>
      <div class="stat"><span class="tico" aria-hidden="true">🎯</span><b id="rAcc">—</b><span>{t.rAcc}</span></div>
      <div class="stat"><span class="tico" aria-hidden="true">⚡</span><b id="rAvg">—</b><span>{t.rAvg}</span></div>
      <div class="stat"><span class="tico" aria-hidden="true">🐇</span><b id="rFast">—</b><span>{t.rFast}</span></div>
      <div class="stat"><span class="tico" aria-hidden="true">🐢</span><b id="rSlow">—</b><span>{t.rSlow}</span></div>
      <div class="stat"><span class="tico" aria-hidden="true">⏳</span><b id="rDur">0:00</b><span>{t.rDur}</span></div>
    </div>
    <div class="card">
      <div class="lbl" id="misTitle"><span class="tico" aria-hidden="true">🐞</span>{t.mistakes}</div>
      <div id="misList" class="mis"></div>
    </div>
    <div class="card" id="skippedCard" hidden>
      <div class="lbl" id="skippedTitle"><span class="tico" aria-hidden="true">⏭️</span>{t.skippedTitle}</div>
      <div class="hint">{t.skippedHint}</div>
      <div id="skippedList" class="mis"></div>
    </div>
    <div class="card" id="slowCard" hidden>
      <div class="lbl" id="slowTitle"><span class="tico" aria-hidden="true">🐢</span>{t.slowTitle}</div>
      <div class="hint">{t.slowHint}</div>
      <div id="slowList" class="mis"></div>
      <div class="slow-actions">
        <button id="slowBtn" class="btn primary" type="button">{t.slowBtn}</button>
      </div>
    </div>
    <div class="card" id="unsolvedCard" hidden>
      <div class="lbl" id="unsolvedTitle"><span class="tico" aria-hidden="true">🤔</span>{t.unsolvedTitle}</div>
      <div class="hint">{t.unsolvedHint}</div>
      <div id="unsolvedList" class="mis"></div>
      <div class="slow-actions">
        <button id="unsolvedBtn" class="btn primary" type="button">{t.unsolvedBtn}</button>
      </div>
    </div>
    <div class="actions">
      <button id="againBtn" class="btn primary" type="button">{t.again}</button>
      <button id="toSetupBtn" class="btn" type="button">{t.settings}</button>
    </div>
  </div>
</section>
<script is:inline src={asset('js/math-problems.js') + '?v=' + jsVersion}></script>
<script is:inline src={asset('js/skills.js') + '?v=' + jsVersion}></script>
</BaseLayout>
