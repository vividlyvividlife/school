---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteCopy, type Lang } from '../../i18n/site';
import { readingWorks } from '../../data/reading';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = siteCopy[lang];
const p = c.reading;
const blocks = (text: string) => text.split(/\n{2,}/);
---

<BaseLayout title={c.readingPage.title} page="reading" lang={lang}>
  <main class="reading">
    <header class="rhero">
      <div class="rkicker">{p.kicker}</div>
      <h1>{p.h1}</h1>
      <p class="rsub">{p.sub}</p>
    </header>

    <ul class="works">
      {readingWorks.map((w) => (
        <li>
          {w.text ? (
            <details class="work" name="reading-work">
              <summary class="wsum">
                <span class="wmain">
                  <span class="wauthor">{w.author}</span>
                  <span class="wtitle">{w.title}</span>
                </span>
                <span class="wactions">
                  <span class="wtoggle">
                    <span class="wread">{p.read}</span>
                    <svg class="wchev" viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M5 7.5l5 5 5-5" />
                    </svg>
                  </span>
                  <button class="wprint" type="button" aria-label={p.print} title={p.print}>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M6 9V3h12v6" />
                      <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                      <path d="M6 14h12v7H6z" />
                    </svg>
                    <span class="wprint-label">{p.print}</span>
                  </button>
                </span>
              </summary>
              <div class="wtext">
                {blocks(w.text).map((par) => <p>{par}</p>)}
              </div>
            </details>
          ) : (
            <div class="work work-soon">
              <div class="wmain">
                <span class="wauthor">{w.author}</span>
                <span class="wtitle">{w.title}</span>
              </div>
              <span class="wsoon">{p.textSoon}</span>
            </div>
          )}
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>

<style>
  .reading {
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    padding: clamp(1.2rem, 4vw, 2.6rem) clamp(0.9rem, 4vw, 2rem) 4rem;
  }
  .rhero {
    text-align: center;
    margin: 0 0 clamp(1.2rem, 3.5vw, 2rem);
  }
  .rkicker {
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--site-teal);
    background: var(--site-surface);
    border: 1px solid var(--site-line);
    border-radius: 999px;
    padding: 0.32rem 0.75rem;
    margin-bottom: 0.9rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.7rem, 5vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .rsub {
    margin: 0.6rem 0 0;
    color: var(--site-muted);
    font-size: clamp(0.95rem, 2.4vw, 1.05rem);
  }
  .works {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .works li {
    min-width: 0;
  }
  .work {
    background: var(--site-surface);
    border: 1px solid var(--site-line);
    border-radius: 12px;
    box-shadow: 0 8px 24px -24px rgba(15, 23, 42, 0.45);
    overflow: hidden;
    transition: border-color 0.15s;
  }
  .work[open] {
    border-color: var(--site-teal-line);
  }
  .wsum {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    cursor: pointer;
    list-style: none;
  }
  .wsum::-webkit-details-marker {
    display: none;
  }
  .wsum::marker {
    content: "";
  }
  .wsum:focus-visible {
    outline: 3px solid var(--site-teal-line);
    outline-offset: -3px;
    border-radius: 12px;
  }
  .wmain {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1 1 auto;
    min-width: 0;
  }
  .wauthor {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--site-muted);
    line-height: 1.3;
  }
  .wtitle {
    font-family: "DM Sans", "Segoe UI", Roboto, Arial, sans-serif;
    font-size: 1.03rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.005em;
    transition: color 0.15s;
  }
  .wsum:hover .wtitle {
    color: var(--site-teal-d);
  }
  .wactions {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .wtoggle {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.38rem 0.65rem;
    border: 1px solid var(--site-line);
    border-radius: 0.55rem;
    background: var(--site-surface-2);
    color: var(--site-teal);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.2;
    transition: background 0.15s, border-color 0.15s;
  }
  .wprint {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.38rem 0.65rem;
    border: 1px solid var(--site-line);
    border-radius: 0.55rem;
    background: var(--site-surface);
    color: var(--site-link);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .wprint svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .wprint:hover {
    background: var(--site-teal-soft);
    border-color: var(--site-teal-line);
    color: var(--site-teal-d);
  }
  .wprint:focus-visible {
    outline: 3px solid var(--site-teal-line);
    outline-offset: 2px;
  }
  .wsum:hover .wtoggle {
    background: var(--site-teal-soft);
    border-color: var(--site-teal-line);
  }
  .work[open] .wtoggle {
    background: var(--site-teal-soft);
    border-color: var(--site-teal-line);
  }
  .wchev {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.18s ease;
  }
  .work[open] .wchev {
    transform: rotate(180deg);
  }
  .wtext {
    padding: 0.95rem 1.1rem 1.15rem;
    border-top: 1px solid var(--site-line);
    background: var(--site-surface-3);
  }
  .wtext p {
    margin: 0 0 0.85rem;
    white-space: pre-line;
    font-size: 0.97rem;
    line-height: 1.55;
    color: var(--site-ink);
  }
  .wtext p:last-child {
    margin-bottom: 0;
  }
  .work-soon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    padding: 0.85rem 1.1rem;
  }
  .work-soon .wmain {
    flex: 1 1 12rem;
  }
  .wsoon {
    flex: 0 0 auto;
    font-size: 0.78rem;
    font-style: italic;
    color: var(--site-muted);
  }
  @media (max-width: 640px) {
    .wsum,
    .work-soon {
      padding: 0.8rem 0.9rem;
    }
    .wtext {
      padding: 0.85rem 0.9rem 1rem;
    }
    .wtoggle,
    .wprint {
      padding: 0.35rem 0.5rem;
    }
    .wactions {
      gap: 0.3rem;
    }
    .wread,
    .wprint-label {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wchev,
    .wtitle,
    .wtoggle,
    .wprint,
    .work {
      transition: none;
    }
  }
</style>

<style is:global>
  @media print {
    body.printing-work .site-nav,
    body.printing-work .site-top,
    body.printing-work .site-scrim,
    body.printing-work .rhero,
    body.printing-work .works > li:not(.is-printing) {
      display: none !important;
    }
    body.printing-work .reading {
      max-width: none;
      margin: 0;
      padding: 0;
    }
    body.printing-work .works {
      display: block;
      margin: 0;
      padding: 0;
    }
    body.printing-work .is-printing .work {
      border: 0;
      border-radius: 0;
      box-shadow: none;
      overflow: visible;
    }
    body.printing-work .is-printing .wsum {
      padding: 0 0 0.75rem;
    }
    body.printing-work .is-printing .wactions {
      display: none !important;
    }
    body.printing-work .is-printing .wtext {
      display: block !important;
      padding: 0.75rem 0 0;
      border-top: 1px solid #cbd5e1;
      background: none;
    }
    body.printing-work .is-printing .wtext p {
      margin: 0 0 0.8em;
      color: #000;
      font-size: 12pt;
      line-height: 1.5;
    }
    body.printing-work .is-printing .wauthor {
      color: #444;
      font-size: 9pt;
    }
    body.printing-work .is-printing .wtitle {
      color: #000;
      font-size: 16pt;
    }
    @page {
      margin: 16mm;
    }
  }
</style>

<script>
  document.querySelectorAll('.wprint').forEach((btn) => {
    btn.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      const details = btn.closest('details');
      const item = details?.closest('li');
      if (!details || !item) return;
      const wasOpen = details.open;
      details.open = true;
      item.classList.add('is-printing');
      document.body.classList.add('printing-work');
      const cleanup = () => {
        window.removeEventListener('afterprint', cleanup);
        document.body.classList.remove('printing-work');
        item.classList.remove('is-printing');
        if (!wasOpen) details.open = false;
      };
      window.addEventListener('afterprint', cleanup);
      window.print();
    });
  });
</script>
