---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteCopy, type Lang } from '../../i18n/site';
import '../../styles/trainer.css';
import '../../styles/vivid-trainer.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = siteCopy[lang];
const p = c.trainer;
const B = import.meta.env.BASE_URL;
const asset = (path: string) => B.replace(/\/+$/, '') + '/' + path.replace(/^\/+/, '');
const jsVersion = Date.now().toString(36);
/* bump when regenerating the dictation audio banks */
const dictBankVersion = '8';
const dictBanks = {
  light: {
    f: {
      audio: asset('audio/dictation/f5-xenia.mp3') + '?v=' + dictBankVersion,
      timings: asset('audio/dictation/f5-xenia.json') + '?v=' + dictBankVersion
    },
    m: {
      audio: asset('audio/dictation/f5-aidar.mp3') + '?v=' + dictBankVersion,
      timings: asset('audio/dictation/f5-aidar.json') + '?v=' + dictBankVersion
    }
  },
  full: {
    f: {
      audio: asset('audio/dictation/f5-xenia-full.mp3') + '?v=' + dictBankVersion,
      timings: asset('audio/dictation/f5-xenia-full.json') + '?v=' + dictBankVersion
    },
    m: {
      audio: asset('audio/dictation/f5-aidar-full.mp3') + '?v=' + dictBankVersion,
      timings: asset('audio/dictation/f5-aidar-full.json') + '?v=' + dictBankVersion
    }
  }
};
const offlineFile = lang === 'en' ? 'offline/en-practice.html' : 'offline/primery.html';
const downloadName = lang === 'en' ? 'math-practice.html' : 'primery.html';
---

<BaseLayout
  title={c.trainerPage.title}
  page="trainer"
  lang={lang}
  crumbs={[lang === 'en' ? 'Math' : 'Математика', lang === 'en' ? 'Practice' : 'Примеры']}
>
<section id="setup" class="screen active">
  <div class="wrap">
    <h1>{p.h1}</h1>
    <p class="sub">{p.sub}</p>

    <div class="v-setup">
      <section class="v-section">
        <header class="v-head">
          <span class="v-num">1</span>
          <div><h2>{p.grade}</h2><p>{p.gradeHint}</p></div>
        </header>
        <div class="seg class-seg v-class">
          <button type="button" data-c="1">{p.grade1}</button>
          <button type="button" data-c="2">{p.grade2}</button>
          <button type="button" data-c="3">{p.grade3}</button>
        </div>
      </section>

      <section class="v-section">
        <header class="v-head">
          <span class="v-num">2</span>
          <div><h2>{p.actions}</h2><p>{p.actionsHint}</p></div>
        </header>
        <div class="seg multi ops-seg v-ops" data-key="ops" data-multi="1">
          <button type="button" data-v="add" title={p.addTitle}><span class="v-op-symbol">+</span><span class="v-op-label">{p.addTitle}</span></button>
          <button type="button" data-v="sub" title={p.subTitle}><span class="v-op-symbol">−</span><span class="v-op-label">{p.subTitle}</span></button>
          <button type="button" data-v="mul" title={p.mulTitle}><span class="v-op-symbol">×</span><span class="v-op-label">{p.mulTitle}</span></button>
          <button type="button" data-v="div" title={p.divTitle}><span class="v-op-symbol">÷</span><span class="v-op-label">{p.divTitle}</span></button>
        </div>
      </section>

      <section class="v-section">
        <header class="v-head">
          <span class="v-num">3</span>
          <div><h2>{p.count}</h2></div>
        </header>
        <div class="v-range">
          <div class="v-stepper-field">
            <span class="v-field-label">{p.from}</span>
            <div class="v-stepper">
              <button type="button" class="v-step" data-target="from" data-step="-1" aria-label="−">−</button>
              <input id="from" class="v-num-input" type="number" inputmode="numeric" min="0" max="100" step="1" value="0">
              <button type="button" class="v-step" data-target="from" data-step="1" aria-label="+">+</button>
            </div>
          </div>
          <div class="v-stepper-field">
            <span class="v-field-label">{p.to}</span>
            <div class="v-stepper">
              <button type="button" class="v-step" data-target="limit" data-step="-1" aria-label="−">−</button>
              <input id="limit" class="v-num-input" type="number" inputmode="numeric" min="1" max="100" step="1" value="18">
              <button type="button" class="v-step" data-target="limit" data-step="1" aria-label="+">+</button>
            </div>
          </div>
        </div>
        <div class="chips" id="limitChips">
          <button type="button" data-v="20">20</button>
          <button type="button" data-v="30">30</button>
          <button type="button" data-v="50">50</button>
          <button type="button" data-v="100">100</button>
        </div>
        <div class="hint" id="rangeHint" hidden>{p.rangeHint}</div>
      </section>

      <section class="v-section">
        <header class="v-head">
          <span class="v-num">4</span>
          <div><h2>{p.missing}</h2></div>
        </header>
        <div class="seg miss-seg v-grid-3" data-key="miss">
          <button type="button" data-v="r">{p.answerR}</button>
          <button type="button" data-v="a">{p.answerA}</button>
          <button type="button" data-v="b">{p.answerB}</button>
          <button type="button" data-v="ab">{p.answerAB}</button>
          <button type="button" data-v="rab">{p.answerRab}</button>
          <button type="button" data-v="all">{p.answerAll}</button>
        </div>
        <div class="hint v-dict-note">{p.missDictNote}</div>
        <div class="hint" id="missHint" hidden></div>
      </section>

      <section class="v-section">
        <header class="v-head">
          <span class="v-num">5</span>
          <div><h2>{p.answerWith}</h2></div>
        </header>
        <div class="seg answer-seg v-answer-grid" data-key="answer">
          <button type="button" data-v="type"><span class="v-ans-preview"><i>7</i><i>8</i><i>9</i></span><span class="v-ans-title">{p.answerType}</span></button>
          <button type="button" data-v="tiles6"><span class="v-ans-preview"><i>6</i></span><span class="v-ans-title">{p.answerTiles6}</span></button>
          <button type="button" data-v="tiles9"><span class="v-ans-preview"><i>9</i></span><span class="v-ans-title">{p.answerTiles9}</span></button>
          <button type="button" data-v="tiles12"><span class="v-ans-preview"><i>12</i></span><span class="v-ans-title">{p.answerTiles12}</span></button>
        </div>
      </section>

      {lang === 'ru' && (
        <section class="v-section">
          <header class="v-head">
            <span class="v-num">6</span>
            <div><h2>{p.format}</h2></div>
          </header>
          <div class="seg format-seg v-seg" data-key="format">
            <button type="button" data-v="visual">{p.formatVisual}</button>
            <button type="button" data-v="dictation">{p.formatDictation}</button>
            <button type="button" data-v="dictation-full">{p.formatDictationFull}</button>
          </div>
          <div class="hint" id="formatHint">{p.formatHint}</div>
          <div class="hint v-dict-note">{p.dictModeNote}</div>
          <div class="v-subhead">{p.voice}</div>
          <div class="seg voice-seg v-seg" data-key="voice">
            <button type="button" data-v="f">{p.voiceFemale}</button>
            <button type="button" data-v="m">{p.voiceMale}</button>
          </div>
          <div class="hint">{p.voiceHint}</div>
        </section>
      )}

      <section class="v-section">
        <header class="v-head">
          <span class="v-num">{lang === 'ru' ? 7 : 6}</span>
          <div><h2>{p.mode}</h2></div>
        </header>
        <div class="seg mode-seg v-seg" data-key="mode">
          <button type="button" data-v="free">{p.modeFree}</button>
          <button type="button" data-v="timed">{p.modeTimed}</button>
        </div>
        <div class="v-time" id="timeRow">
          <span class="v-field-label">{p.duration}</span>
          <span class="numitem"><input id="min" class="v-num-input" type="number" inputmode="numeric" min="0" max="300" value="2"> <span class="dim">{p.minUnit}</span></span>
          <span class="numitem"><input id="sec" class="v-num-input" type="number" inputmode="numeric" min="0" max="59" value="0"> <span class="dim">{p.secUnit}</span></span>
        </div>
      </section>

      <details class="v-section v-more">
        <summary class="v-more-summary">
          <span class="v-num">{lang === 'ru' ? 8 : 7}</span>
          <div><h2>{p.extra}</h2></div>
          <span class="v-chev" aria-hidden="true">⌄</span>
        </summary>
        <div class="v-more-body">
          <label class="switch v-switch">
            <input id="carry" type="checkbox" checked>
            <span class="track"></span>
            <span>{p.carryOnly}</span>
          </label>
          <div class="hint" id="carryHint" hidden>{p.carryHint}</div>
          <label class="switch v-switch">
            <input id="trickZero" type="checkbox">
            <span class="track"></span>
            <span>{p.trickZero}</span>
          </label>
          <div class="hint" id="trickHint" hidden></div>
          <div class="v-subhead">{p.sound}</div>
          <div class="sound-row">
            <label class="switch v-switch">
              <input id="sound" type="checkbox" checked>
              <span class="track"></span>
              <span>{p.soundLabel}</span>
            </label>
            <button id="soundTest" class="btn small" type="button">{p.soundTest}</button>
          </div>
          <div class="hint">{p.soundHint}</div>
        </div>
      </details>

      <section class="v-section v-hard">
        <header class="v-head">
          <span class="v-num">🌱</span>
          <div><h2>{p.hardTitle}</h2><p id="hardInfo">{p.hardInfo}</p></div>
        </header>
        <div id="hardList" class="exlist" hidden></div>
        <div class="hard-actions">
          <button id="hardBtn" class="btn" type="button" disabled>{p.hardBtn}</button>
          <button id="clearHard" class="btn small" type="button" hidden>{p.clearHard}</button>
        </div>
      </section>

      <section class="v-section v-history">
        <header class="v-head">
          <span class="v-num">📜</span>
          <div><h2>{p.history}</h2></div>
        </header>
        <div id="histList" class="hist"></div>
        <button id="clearHist" class="btn small" type="button">{p.clear}</button>
      </section>
    </div>

    <div class="v-startbar">
      <div class="v-startbar-inner">
        <div class="v-start-info">
          <div class="v-start-kicker">{p.setTitle}</div>
          <div class="hint" id="poolInfo">{p.poolInfo}</div>
          <a class="v-offline" href={asset(offlineFile)} download={downloadName} title={p.offlineTitle} data-offline-hide>{p.offline}</a>
        </div>
        <button id="startBtn" class="btn primary v-start-btn" type="button">{p.start}</button>
      </div>
    </div>
  </div>
</section>

<section id="game" class="screen v-game">
  <div class="v-game-head">
    <button id="stopBtn" class="v-round-btn" type="button" aria-label={p.stop}>×</button>
    <div class="v-score-row">
      <span class="v-pill ok"><span aria-hidden="true">✓</span><b id="scoreOk">0</b></span>
      <span class="v-pill bad"><span aria-hidden="true">×</span><b id="scoreBad">0</b></span>
      <span class="gmeta" id="gInfo"></span>
    </div>
    <button id="pauseBtn" class="v-round-btn pause-btn" type="button" aria-pressed="false" hidden data-pause={p.pause} data-resume={p.resume}>{p.pause}</button>
  </div>

  <div class="timewrap" id="timeWrap">
    <div class="tbar"><div class="tfill" id="tfill"></div></div>
    <div class="tclock" id="tclock">0:00</div>
  </div>

  <div class="v-game-body">
    <div class="eqwrap eqw v-qcard" id="eqw">
      <div class="eq" id="eq"></div>
      <div class="dict" id="dict" hidden>
        <button class="dict-play" id="dictRepeat" type="button" aria-label={p.dictRepeatAria}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 9.2v5.6h3.6L13 19V5L7.6 9.2H4z" fill="currentColor"/>
            <path d="M16.3 8.4a5 5 0 010 7.2M18.9 5.8a8.6 8.6 0 010 12.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span class="dict-badge" id="dictLeft">1</span>
        </button>
        <div class="dict-answer" id="dictAnswer"></div>
        <div class="dict-label" id="dictLabel">{p.dictListen}</div>
        <div class="dict-note" id="dictNote">{p.dictNote}</div>
      </div>
      <div class="cap" id="cap"></div>
      <div class="pairinfo" id="pairInfo" hidden></div>
      <button id="skipBtn" class="v-skip-btn" type="button">{p.skip}</button>
      <div class="v-beads-row">
        <button id="beadsBtn" class="v-beads-btn" type="button" hidden></button>
        <button id="placeBtn" class="v-beads-btn" type="button" hidden></button>
        <button id="compBtn" class="v-beads-btn" type="button" hidden></button>
        <button id="diffBtn" class="v-beads-btn" type="button" hidden></button>
      </div>
    </div>

    <div class="padwrap v-answer">
      <div class="pad tiles" id="tiles" hidden></div>
      <div class="pad" id="pad">
        <button type="button" data-k="1">1</button>
        <button type="button" data-k="2">2</button>
        <button type="button" data-k="3">3</button>
        <button type="button" data-k="4">4</button>
        <button type="button" data-k="5">5</button>
        <button type="button" data-k="6">6</button>
        <button type="button" data-k="7">7</button>
        <button type="button" data-k="8">8</button>
        <button type="button" data-k="9">9</button>
        <button type="button" data-k="del" class="del">⌫</button>
        <button type="button" data-k="0">0</button>
        <button type="button" data-k="ok" class="ok">OK</button>
        <button id="cannotBtn" type="button" data-k="none" class="cannot">{p.trick}</button>
      </div>
    </div>
  </div>
  <div class="beads-panel" id="beadsPanel" hidden>
    <div class="beads-card" role="dialog" aria-modal="true">
      <div class="beads-head">
        <span class="beads-eq" id="beadsEq"></span>
        <button class="beads-close" id="beadsClose" type="button" aria-label="×">×</button>
      </div>
      <div class="beads-legend" id="beadsLegend"></div>
      <div class="beads-step-title" id="beadsTitle" hidden></div>
      <div class="beads-stage" id="beadsStage"></div>
      <div class="beads-note" id="beadsNote"></div>
      <div class="beads-actions">
        <span class="beads-dots" id="beadsDots" hidden></span>
        <button class="beads-step" id="beadsPrev" type="button" hidden>←</button>
        <button class="beads-step primary" id="beadsNext" type="button"></button>
      </div>
    </div>
  </div>
</section>

<section id="results" class="screen">
  <div class="wrap">
    <h2 id="resTitle">{p.resTitle}</h2>
    <div class="verdict" id="verdict"></div>
    <div class="verdict" id="advice" hidden></div>
    <div class="stats">
      <div class="stat good"><span class="tico" aria-hidden="true">✅</span><b id="rOk">0</b><span>{p.rOk}</span></div>
      <div class="stat bad"><span class="tico" aria-hidden="true">❌</span><b id="rBad">0</b><span>{p.rBad}</span></div>
      <div class="stat skip"><span class="tico" aria-hidden="true">⏭️</span><b id="rSkip">0</b><span>{p.rSkip}</span></div>
      <div class="stat"><span class="tico" aria-hidden="true">🎯</span><b id="rAcc">—</b><span>{p.rAcc}</span></div>
      <div class="stat"><span class="tico" aria-hidden="true">⚡</span><b id="rAvg">—</b><span>{p.rAvg}</span></div>
      <div class="stat"><span class="tico" aria-hidden="true">🐇</span><b id="rFast">—</b><span>{p.rFast}</span></div>
      <div class="stat"><span class="tico" aria-hidden="true">🐢</span><b id="rSlow">—</b><span>{p.rSlow}</span></div>
      <div class="stat"><span class="tico" aria-hidden="true">⏳</span><b id="rDur">0:00</b><span>{p.rDur}</span></div>
    </div>
    <div class="card">
      <div class="lbl" id="misTitle"><span class="tico" aria-hidden="true">🐞</span>{p.mistakes}</div>
      <div id="misList" class="mis"></div>
    </div>
    <div class="card" id="skippedCard" hidden>
      <div class="lbl" id="skippedTitle"><span class="tico" aria-hidden="true">⏭️</span>{p.skippedTitle}</div>
      <div class="hint">{p.skippedHint}</div>
      <div id="skippedList" class="mis"></div>
    </div>
    <div class="card" id="slowCard" hidden>
      <div class="lbl" id="slowTitle"><span class="tico" aria-hidden="true">🐢</span>{p.slowTitle}</div>
      <div class="hint">{p.slowHint}</div>
      <div id="slowList" class="mis"></div>
      <div class="slow-actions">
        <button id="slowBtn" class="btn primary" type="button">{p.slowBtn}</button>
      </div>
    </div>
    <div class="card" id="unsolvedCard" hidden>
      <div class="lbl" id="unsolvedTitle"><span class="tico" aria-hidden="true">🤔</span>{p.unsolvedTitle}</div>
      <div class="hint">{p.unsolvedHint}</div>
      <div id="unsolvedList" class="mis"></div>
      <div class="slow-actions">
        <button id="unsolvedBtn" class="btn primary" type="button">{p.unsolvedBtn}</button>
      </div>
    </div>
    <div class="card" id="pairsCard" hidden>
      <div class="lbl"><span class="tico" aria-hidden="true">🎴</span>{p.pairs}</div>
      <div id="pairsList" class="pairs"></div>
    </div>
    <div class="card" id="retryCard" hidden>
      <div class="lbl"><span class="tico" aria-hidden="true">🔁</span>{p.retry}</div>
      <div class="retryeq" id="retryEq"></div>
      <div class="retrybtns" id="retryBtns"></div>
    </div>
    <div class="actions">
      <button id="againBtn" class="btn primary" type="button">{p.again}</button>
      <button id="toSetupBtn" class="btn" type="button">{p.settings}</button>
    </div>
  </div>
</section>
{lang === 'ru' && (
  <>
    <script is:inline define:vars={{ dictBanks }}>
      window.__DICTATION__ = dictBanks;
    </script>
    <script is:inline src={asset('js/dictation.js') + '?v=' + jsVersion}></script>
  </>
)}
<script is:inline src={asset('js/trainer.js') + '?v=' + jsVersion}></script>
</BaseLayout>
