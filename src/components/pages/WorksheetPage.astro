---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteCopy, type Lang } from '../../i18n/site';
import { skillCopy } from '../../i18n/skills';
import '../../styles/examples.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = siteCopy[lang];
const p = c.worksheet;
const B = import.meta.env.BASE_URL;
const asset = (path: string) => B.replace(/\/+$/, '') + '/' + path.replace(/^\/+/, '');
const jsVersion = Date.now().toString(36);
const offlineFile = lang === 'en' ? 'offline/en-worksheets.html' : 'offline/razdatochnyy-material.html';
const downloadName = lang === 'en' ? 'math-worksheets.html' : 'razdatochnyy-material.html';
const typeEntries: [string, string][] = [
  ['examples', p.typeExamples],
  ['digits', p.typeDigits],
  ['compare', p.typeCompare],
  ['missing', p.typeMissing],
  ['brackets', p.typeBrackets],
  ['units', p.typeUnits],
  ['perimeter', p.typePerimeter]
];
const rangeHints: Record<string, string> = {
  examples: p.rangeHintExamples,
  digits: p.rangeHintDigits,
  compare: p.rangeHintCompare,
  missing: p.rangeHintMissing,
  brackets: p.rangeHintBrackets,
  units: p.rangeHintUnits,
  perimeter: p.rangeHintPerimeter
};
const taskEntries: [string, [string, string][]][] = [
  ['digits', Object.entries(skillCopy[lang].digits.tasks)],
  ['compare', Object.entries(skillCopy[lang].compare.tasks)],
  ['brackets', Object.entries(skillCopy[lang].brackets.tasks)],
  ['units', Object.entries(skillCopy[lang].units.tasks)],
  ['perimeter', Object.entries(skillCopy[lang].perimeter.tasks)]
];
const missingEntries: [string, string][] = [
  ['r', p.missR],
  ['a', p.missA],
  ['b', p.missB],
  ['ra', p.missRA],
  ['rb', p.missRB],
  ['ab', p.missAB],
  ['all', p.missAll]
];
const answerEntries: [string, string][] = [
  ['none', p.ansNone],
  ['faint', p.ansFaint],
  ['key', p.ansKey]
];
---

<BaseLayout title={c.worksheetPage.title} page="examples" lang={lang}>
<div class="toolbar">
  <div class="toolbar-inner">
    <section class="tgroup tgroup-type" aria-labelledby="tg-type">
      <div class="tgroup-title" id="tg-type">{p.typeTitle}</div>
      <div class="tgroup-body">
        <div class="types" id="sheet-type" role="radiogroup" aria-label={p.typeTitle}>
          {typeEntries.map(([key, label]) => (
            <label class="type">
              <input type="radio" name="sheet-type" value={key} checked={key === 'examples'}>
              <span>{label}</span>
            </label>
          ))}
        </div>
      </div>
    </section>

    <div class="tgroups">
      <section class="tgroup" aria-labelledby="tg-grid">
        <div class="tgroup-title" id="tg-grid">{p.gridTitle}</div>
        <div class="tgroup-body">
          <label class="fld">{p.rows}<input id="rows" type="number" min="2" max="40" value="8"></label>
          <label class="fld">{p.cols}<input id="cols" type="number" min="2" max="10" value="3"></label>
          <label class="fld">{p.pages}<input id="pages" type="number" min="1" max="12" value="1"></label>
        </div>
      </section>

      <section class="tgroup" aria-labelledby="tg-range">
        <div class="tgroup-title" id="tg-range">{p.rangeTitle}</div>
        <div class="tgroup-body">
          <label class="fld">{p.from}<input id="from" type="number" min="0" max="100" value="0"></label>
          <label class="fld">{p.to}<input id="limit" type="number" min="1" max="100" value="18"></label>
          <div class="range-hint" id="range-hint">
            {typeEntries.map(([key]) => <span data-for={key} hidden={key !== 'examples'}>{rangeHints[key]}</span>)}
          </div>
        </div>
      </section>

      <section class="tgroup" data-only="examples missing brackets" aria-labelledby="tg-actions">
        <div class="tgroup-title" id="tg-actions">{p.actions}</div>
        <div class="tgroup-body">
          <div class="ops" id="ops" role="group" aria-label={p.actions}>
            <label class="op" title={p.addition}><input type="checkbox" value="add" checked aria-label={p.addition}><span aria-hidden="true">+</span></label>
            <label class="op" title={p.subtraction}><input type="checkbox" value="sub" checked aria-label={p.subtraction}><span aria-hidden="true">−</span></label>
            <label class="op" title={p.multiplication}><input type="checkbox" value="mul" aria-label={p.multiplication}><span aria-hidden="true">×</span></label>
            <label class="op" title={p.division}><input type="checkbox" value="div" aria-label={p.division}><span aria-hidden="true">÷</span></label>
          </div>
        </div>
      </section>

      <section class="tgroup" data-only="examples missing" aria-labelledby="tg-carry">
        <div class="tgroup-title" id="tg-carry">{p.extra}</div>
        <div class="tgroup-body">
          <label class="switch" title={p.carryTitle}>
            <input id="carry" type="checkbox" checked>
            <span class="track"></span>
            <span>{p.carry}</span>
          </label>
        </div>
      </section>

      <section class="tgroup" data-only="examples missing" aria-labelledby="tg-missing">
        <div class="tgroup-title" id="tg-missing">{p.missing}</div>
        <div class="tgroup-body">
          <div class="seg seg-miss" id="miss" role="radiogroup" aria-label={p.missing}>
            {missingEntries.map(([key, label]) => (
              <label>
                <input type="radio" name="miss-mode" value={key} checked={key === 'r'}>
                <span>{label}</span>
              </label>
            ))}
          </div>
        </div>
      </section>

      {taskEntries.map(([forType, entries]) => (
        <section class="tgroup" data-only={forType} hidden>
          <div class="tgroup-title">{p.tasksTitle}</div>
          <div class="tgroup-body">
            <div class="chips" data-tasks={forType}>
              {entries.map(([key, label]) => (
                <label><input type="checkbox" value={key} checked><span>{label}</span></label>
              ))}
            </div>
            <div class="hint">{p.tasksHint}</div>
          </div>
        </section>
      ))}

      <section class="tgroup" aria-labelledby="tg-answers">
        <div class="tgroup-title" id="tg-answers">{p.answers}</div>
        <div class="tgroup-body">
          <div class="seg seg-ans" id="ans" role="radiogroup" aria-label={p.answers}>
            {answerEntries.map(([key, label]) => (
              <label>
                <input type="radio" name="ans-mode" value={key} checked={key === 'none'}>
                <span>{label}</span>
              </label>
            ))}
          </div>
          <div class="hint">{p.answersHint}</div>
        </div>
      </section>

      <section class="tgroup tgroup-variant" aria-labelledby="tg-variant">
        <div class="tgroup-title" id="tg-variant">{p.variantTitle}</div>
        <div class="tgroup-body">
          <label class="fld">{p.variantKey}<input id="seed" type="number" min="1" value="1234"></label>
          <button id="again" class="btn" type="button">{p.another}</button>
        </div>
      </section>
    </div>

    <div class="tfoot">
      <a class="btn" href={asset(offlineFile)} download={downloadName} title={c.trainer.offlineTitle} data-offline-hide>{c.trainer.offline}</a>
      <div class="tfoot-main">
        <button id="sheet-help" class="btn" type="button" aria-expanded="false" aria-controls="sheet-help-panel">{p.help}</button>
        <button id="print" class="btn primary" type="button">{p.print}</button>
      </div>
      <div id="sheet-help-panel" class="help-panel" hidden>
        <h2>{p.helpTitle}</h2>
        <p>{p.helpType}</p>
        <p>{p.help1}</p>
        <p>{p.help2}</p>
        <p>{p.help3}</p>
      </div>
    </div>
  </div>
</div>

<div id="sheets"></div>
<script is:inline src={asset('js/examples-logic.js') + '?v=' + jsVersion}></script>
<script is:inline src={asset('js/worksheet-tasks.js') + '?v=' + jsVersion}></script>
<script is:inline src={asset('js/examples-ui.js') + '?v=' + jsVersion}></script>
</BaseLayout>
