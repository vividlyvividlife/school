---
import leafMaple from '../assets/fx/leaf-maple.webp';
import leafOak from '../assets/fx/leaf-oak.webp';
import flake from '../assets/fx/flake.webp';
import bee from '../assets/fx/bee.webp';
import heart from '../assets/fx/heart.webp';
import book from '../assets/fx/book.webp';
import brush from '../assets/fx/brush.webp';
import boat from '../assets/fx/boat.webp';
import firefly from '../assets/fx/firefly.webp';
import dandelion from '../assets/fx/dandelion.webp';
import butterfly from '../assets/fx/butterfly.webp';
import bird from '../assets/fx/bird.webp';
import stork from '../assets/fx/stork.webp';
import dove from '../assets/fx/dove.webp';
import petal from '../assets/fx/petal.webp';
import type { ThemeMotif } from '../data/belarusianReadingArt';

interface Props {
  motif: ThemeMotif;
}

const { motif } = Astro.props;

const rnd = (a: number, b: number) => a + Math.random() * (b - a);
const pick = <T,>(arr: T[]): T => arr[Math.floor(Math.random() * arr.length)];
const cap = (arr: Array<{ op: number } & Record<string, unknown>>, max: number) =>
  arr.map((item) => ({ ...item, op: Math.min(item.op, max) }));

const leaflets = Array.from({ length: 14 }, () => ({
  x: rnd(2, 96),
  dur: rnd(3.8, 5.6),
  delay: rnd(0, 1.3),
  size: rnd(26, 54),
  drift: rnd(-16, 16),
  sway: rnd(2.6, 4.2),
  spin: rnd(3, 6),
  img: pick([leafMaple, leafOak]),
  hue: rnd(-14, 18)
}));

const flakes = Array.from({ length: 30 }, () => ({
  x: rnd(0, 100),
  dur: rnd(4, 6.2),
  delay: rnd(0, 1.6),
  size: rnd(9, 30),
  drift: rnd(-14, 14),
  sway: rnd(2.8, 4.6),
  op: 1,
  blur: rnd(0, 1.4),
  sprite: Math.random() < 0.38
}));

const petals = Array.from({ length: 12 }, () => ({
  x: rnd(2, 96),
  dur: rnd(4.6, 6.4),
  delay: rnd(0, 1.8),
  size: rnd(12, 22),
  drift: rnd(-14, 14),
  sway: rnd(2.4, 4),
  spin: rnd(4, 8),
  op: 1
}));

const bees = Array.from({ length: 5 }, (_, i) => ({
  y: rnd(10, 66),
  dur: rnd(5.2, 6.8),
  delay: rnd(0.4, 2.6),
  size: rnd(34, 58),
  bob: rnd(0.9, 1.6),
  right: i % 2 === 0
}));

const drops = Array.from({ length: 22 }, () => ({
  x: rnd(-4, 104),
  dur: rnd(0.9, 1.5),
  delay: rnd(0, 3.2),
  h: rnd(12, 26),
  op: rnd(0.35, 0.7)
}));

const rise = (n: number, min: number, max: number) => Array.from({ length: n }, () => ({
  x: rnd(3, 95),
  dur: rnd(5.2, 7.4),
  delay: rnd(0, 2.2),
  size: rnd(min, max),
  drift: rnd(-22, 22),
  sway: rnd(2.2, 4.2),
  rot: rnd(-14, 14),
  op: 1
}));

const hearts = cap(rise(8, 20, 34), 1);
const books = cap(rise(6, 28, 46), 1);
const brushes = cap(rise(5, 80, 120), 1);
const fireflies = cap(rise(6, 18, 30), 1);
const dandelions = cap(rise(3, 30, 48), 1);
const butterflies = cap(rise(6, 22, 38), 1);
const natureButterflies = cap(rise(3, 22, 36), 1);

const cross = (n: number, min: number, max: number) => Array.from({ length: n }, (_, i) => ({
  y: rnd(8, 74),
  dur: rnd(10.5, 14),
  delay: rnd(0.2, 2.4),
  size: rnd(min, max),
  bob: rnd(1.2, 2.2),
  right: i % 2 === 0
}));

const boats = cross(4, 30, 48);
const birds = cross(6, 24, 42);
const storks = cross(4, 30, 52);
const doves = cross(4, 30, 52);
---

<div class="sfx" data-motif={motif} aria-hidden="true">
  {(motif === 'leaves' || motif === 'nature') && leaflets.map((l, i) => (
    <span class="sfx-p" style={`--x:${l.x}%;--dur:${l.dur}s;--delay:${l.delay}s;--drift:${l.drift}vw`}>
      <span class="sfx-i" style={`--size:${l.size}px;--sway:${l.sway}s;--op:1`}>
        <img
          class="sfx-img sfx-leaf"
          src={(i % 2 ? l.img : leafOak).src}
          width={(i % 2 ? l.img : leafOak).width}
          height={(i % 2 ? l.img : leafOak).height}
          alt=""
          decoding="async"
          style={`--size:${l.size}px;--spin:${l.spin}s;--hue:${l.hue}deg`}
        />
      </span>
    </span>
  ))}

  {motif === 'snow' && flakes.map((f) => (
    <span class="sfx-p" style={`--x:${f.x}%;--dur:${f.dur}s;--delay:${f.delay}s;--drift:${f.drift}vw`}>
      <span class="sfx-i" style={`--size:${f.size}px;--sway:${f.sway}s;--op:${f.op}`}>
        {f.sprite
          ? <img class="sfx-img sfx-flake-img" src={flake.src} width={flake.width} height={flake.height} alt="" style={`filter:blur(${f.blur}px)`} decoding="async" />
          : <span class="sfx-dot" style={`filter:blur(${f.blur}px)`}></span>}
      </span>
    </span>
  ))}

  {motif === 'spring' && (
    <>
      <span class="fx-sun" aria-hidden="true"></span>
      {bees.map((b) => (
        <span class={`sfx-cross-p ${b.right ? 'go-r' : 'go-l'}`} style={`--y:${b.y}%;--dur:${b.dur}s;--delay:${b.delay}s`}>
          <span class="sfx-bee" style={`--size:${b.size}px;--bob:${b.bob}s`}>
            <img src={bee.src} width={bee.width} height={bee.height} alt="" decoding="async" style={b.right ? 'transform:scaleX(-1)' : undefined} />
          </span>
        </span>
      ))}
      {petals.map((p) => (
        <span class="sfx-p" style={`--x:${p.x}%;--dur:${p.dur}s;--delay:${p.delay}s;--drift:${p.drift}vw`}>
          <span class="sfx-i" style={`--size:${p.size}px;--sway:${p.sway}s;--op:${p.op}`}>
            <img class="sfx-img sfx-petal-img" src={petal.src} width={petal.width} height={petal.height} alt="" decoding="async" style={`--size:${p.size}px;--spin:${p.spin}s`} />
          </span>
        </span>
      ))}
      {drops.map((d) => (
        <span class="sfx-p sfx-drop-p" style={`--x:${d.x}%;--dur:${d.dur}s;--delay:${d.delay}s`}>
          <span class="fx-drop" style={`height:${d.h}px;--op:${d.op}`}></span>
        </span>
      ))}
    </>
  )}

  {motif === 'bees' && bees.map((b) => (
    <span class={`sfx-cross-p ${b.right ? 'go-r' : 'go-l'}`} style={`--y:${b.y}%;--dur:${b.dur}s;--delay:${b.delay}s`}>
      <span class="sfx-bee" style={`--size:${b.size}px;--bob:${b.bob}s`}>
        <img src={bee.src} width={bee.width} height={bee.height} alt="" decoding="async" style={b.right ? 'transform:scaleX(-1)' : undefined} />
      </span>
    </span>
  ))}

  {motif === 'butterflies' && butterflies.map((b) => (
    <span class="sfx-rise-p" style={`--x:${b.x}%;--dur:${b.dur}s;--delay:${b.delay}s;--drift:${b.drift}vw`}>
      <span class="sfx-i" style={`--size:${b.size}px;--sway:${b.sway}s;--op:${b.op}`}>
        <img class="sfx-img sfx-butterfly-img" src={butterfly.src} width={butterfly.width} height={butterfly.height} alt="" decoding="async" style={`--size:${b.size}px;--rot:${b.rot}deg`} />
      </span>
    </span>
  ))}

  {motif === 'hearts' && hearts.map((h) => (
    <span class="sfx-rise-p" style={`--x:${h.x}%;--dur:${h.dur}s;--delay:${h.delay}s;--drift:${h.drift}vw`}>
      <span class="sfx-i" style={`--size:${h.size}px;--sway:${h.sway}s;--op:${h.op}`}>
        <img class="sfx-img sfx-tilt-img" src={heart.src} width={heart.width} height={heart.height} alt="" decoding="async" style={`--size:${h.size}px;--rot:${h.rot}deg`} />
      </span>
    </span>
  ))}

  {motif === 'letters' && books.map((b) => (
    <span class="sfx-rise-p" style={`--x:${b.x}%;--dur:${b.dur}s;--delay:${b.delay}s;--drift:${b.drift}vw`}>
      <span class="sfx-i" style={`--size:${b.size}px;--sway:${b.sway}s;--op:${b.op}`}>
        <img class="sfx-img sfx-tilt-img" src={book.src} width={book.width} height={book.height} alt="" decoding="async" style={`--size:${b.size}px;--rot:${b.rot}deg`} />
      </span>
    </span>
  ))}

  {motif === 'notes' && brushes.map((b) => (
    <span class="sfx-rise-p" style={`--x:${b.x}%;--dur:${b.dur}s;--delay:${b.delay}s;--drift:${b.drift}vw`}>
      <span class="sfx-i" style={`--size:${b.size}px;--sway:${b.sway}s;--op:${b.op}`}>
        <img class="sfx-img sfx-tilt-img sfx-brush-img" src={brush.src} width={brush.width} height={brush.height} alt="" decoding="async" style={`--size:${b.size}px;--rot:${b.rot}deg`} />
      </span>
    </span>
  ))}

  {motif === 'magic' && fireflies.map((f) => (
    <span class="sfx-rise-p" style={`--x:${f.x}%;--dur:${f.dur}s;--delay:${f.delay}s;--drift:${f.drift}vw`}>
      <span class="sfx-i" style={`--size:${f.size}px;--sway:${f.sway}s;--op:${f.op}`}>
        <img class="sfx-img sfx-firefly-img" src={firefly.src} width={firefly.width} height={firefly.height} alt="" decoding="async" style={`--size:${f.size}px`} />
      </span>
    </span>
  ))}

  {motif === 'sparkles' && dandelions.map((d) => (
    <span class="sfx-rise-p" style={`--x:${d.x}%;--dur:${d.dur}s;--delay:${d.delay}s;--drift:${d.drift}vw`}>
      <span class="sfx-i" style={`--size:${d.size}px;--sway:${d.sway}s;--op:${d.op}`}>
        <img class="sfx-img sfx-tilt-img" src={dandelion.src} width={dandelion.width} height={dandelion.height} alt="" decoding="async" style={`--size:${d.size}px;--rot:${d.rot}deg`} />
      </span>
    </span>
  ))}

  {motif === 'magic' && natureButterflies.map((b) => (
    <span class="sfx-rise-p" style={`--x:${b.x}%;--dur:${b.dur + 0.6}s;--delay:${b.delay + 0.3}s;--drift:${b.drift}vw`}>
      <span class="sfx-i" style={`--size:${b.size}px;--sway:${b.sway}s;--op:${b.op}`}>
        <img class="sfx-img sfx-butterfly-img" src={butterfly.src} width={butterfly.width} height={butterfly.height} alt="" decoding="async" style={`--size:${b.size}px;--rot:${b.rot}deg`} />
      </span>
    </span>
  ))}

  {motif === 'nature' && natureButterflies.map((b) => (
    <span class="sfx-rise-p" style={`--x:${b.x}%;--dur:${b.dur}s;--delay:${b.delay}s;--drift:${b.drift}vw`}>
      <span class="sfx-i" style={`--size:${b.size}px;--sway:${b.sway}s;--op:${b.op}`}>
        <img class="sfx-img sfx-butterfly-img" src={butterfly.src} width={butterfly.width} height={butterfly.height} alt="" decoding="async" style={`--size:${b.size}px;--rot:${b.rot}deg`} />
      </span>
    </span>
  ))}

  {motif === 'planes' && boats.map((p) => (
    <span class={`sfx-cross-p ${p.right ? 'go-r' : 'go-l'}`} style={`--y:${p.y}%;--dur:${p.dur}s;--delay:${p.delay}s`}>
      <span class="sfx-fly" style={`--size:${p.size}px;--bob:${p.bob}s`}>
        <img class="sfx-img" src={boat.src} width={boat.width} height={boat.height} alt="" decoding="async" style={`--size:${p.size}px`} />
      </span>
    </span>
  ))}

  {motif === 'birds' && birds.map((b) => (
    <span class={`sfx-cross-p ${b.right ? 'go-r' : 'go-l'}`} style={`--y:${b.y}%;--dur:${b.dur}s;--delay:${b.delay}s`}>
      <span class="sfx-fly" style={`--size:${b.size}px;--bob:${b.bob}s`}>
        <img class={`sfx-img sfx-wingbeat${b.right ? '' : ' is-flipped'}`} src={bird.src} width={bird.width} height={bird.height} alt="" decoding="async" style={`--size:${b.size}px`} />
      </span>
    </span>
  ))}

  {motif === 'cranes' && storks.map((s) => (
    <span class={`sfx-cross-p ${s.right ? 'go-r' : 'go-l'}`} style={`--y:${s.y}%;--dur:${s.dur}s;--delay:${s.delay}s`}>
      <span class="sfx-fly" style={`--size:${s.size}px;--bob:${s.bob}s`}>
        <img class={`sfx-img sfx-wingbeat${s.right ? '' : ' is-flipped'}`} src={stork.src} width={stork.width} height={stork.height} alt="" decoding="async" style={`--size:${s.size}px`} />
      </span>
    </span>
  ))}

  {motif === 'doves' && doves.map((d) => (
    <span class={`sfx-cross-p ${d.right ? 'go-r' : 'go-l'}`} style={`--y:${d.y}%;--dur:${d.dur}s;--delay:${d.delay}s`}>
      <span class="sfx-fly" style={`--size:${d.size}px;--bob:${d.bob}s`}>
        <img class={`sfx-img sfx-wingbeat${d.right ? '' : ' is-flipped'}`} src={dove.src} width={dove.width} height={dove.height} alt="" decoding="async" style={`--size:${d.size}px`} />
      </span>
    </span>
  ))}
</div>

<style>
  .sfx {
    position: fixed;
    inset: 3.55rem 0 0;
    z-index: 5;
    pointer-events: none;
    overflow: hidden;
    animation: sfx-out 0.9s ease-in 6.9s forwards;
  }
  .sfx-p {
    position: absolute;
    top: -14%;
    left: var(--x);
    will-change: transform;
    animation: sfx-fall var(--dur) linear var(--delay) forwards;
  }
  .sfx-rise-p {
    position: absolute;
    bottom: -12%;
    left: var(--x);
    will-change: transform;
    animation: sfx-rise var(--dur) linear var(--delay) forwards;
  }
  .sfx-i {
    display: block;
    opacity: var(--op, 1);
    transform-origin: center;
    animation: sfx-sway var(--sway) ease-in-out var(--delay) infinite alternate;
  }
  .sfx-img {
    display: block;
    width: var(--size);
    height: auto;
    filter: drop-shadow(0 3px 5px rgba(40, 30, 20, 0.16));
  }

  .sfx-leaf {
    filter: hue-rotate(var(--hue)) drop-shadow(0 2px 3px rgba(60, 30, 10, 0.18));
    animation: sfx-spin var(--spin) linear infinite;
  }
  .sfx-flake-img { filter: none; }
  .sfx-brush-img { height: var(--size); width: auto; }
  .sfx-petal-img { animation: sfx-spin var(--spin) linear infinite; }
  .sfx-tilt-img { transform: rotate(var(--rot)); }
  .sfx-butterfly-img { animation: sfx-flutter 1.4s ease-in-out infinite alternate; }
  .sfx-firefly-img { animation: sfx-glow 1.8s ease-in-out infinite alternate; }
  .sfx-wingbeat { --dir: 1; transform-origin: 50% 55%; animation: sfx-wingbeat 0.48s ease-in-out infinite; }
  .sfx-wingbeat.is-flipped { --dir: -1; }

  .sfx-dot {
    display: block;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%,
      #ffffff 0 40%,
      rgba(255, 255, 255, 0.85) 55%,
      rgba(220, 236, 255, 0.45) 74%,
      rgba(255, 255, 255, 0) 100%);
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.55);
  }

  .fx-sun {
    position: absolute;
    top: 4%;
    left: 8%;
    width: clamp(160px, 30vw, 340px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%,
      rgba(255, 249, 224, 0.55) 0 18%,
      rgba(255, 236, 170, 0.34) 34%,
      rgba(255, 224, 140, 0.14) 55%,
      rgba(255, 224, 140, 0) 72%);
    filter: blur(6px);
    animation: sfx-sun 7.6s ease-out forwards;
  }
  .sfx-cross-p {
    position: absolute;
    top: var(--y);
    left: 0;
    will-change: transform;
  }
  .go-r { animation: sfx-cross-r var(--dur) linear var(--delay) both; }
  .go-l { animation: sfx-cross-l var(--dur) linear var(--delay) both; }
  .sfx-bee, .sfx-fly {
    display: block;
    animation: sfx-bob var(--bob) ease-in-out infinite alternate;
  }
  .sfx-fly { opacity: 1; }
  .sfx-bee img {
    display: block;
    width: var(--size);
    height: auto;
    filter: drop-shadow(0 3px 4px rgba(40, 30, 10, 0.15));
  }
  .sfx-drop-p {
    top: -10%;
    animation: sfx-fall var(--dur) linear var(--delay) infinite;
  }
  .fx-drop {
    display: block;
    width: 2px;
    border-radius: 2px;
    opacity: var(--op);
    background: linear-gradient(to bottom, rgba(180, 215, 255, 0), rgba(150, 200, 255, 0.9));
    transform: rotate(9deg);
  }

  @keyframes sfx-fall {
    from { transform: translate3d(0, -14vh, 0); }
    to { transform: translate3d(var(--drift), 118vh, 0); }
  }
  @keyframes sfx-rise {
    from { transform: translate3d(0, 12vh, 0); }
    to { transform: translate3d(var(--drift), -120vh, 0); }
  }
  @keyframes sfx-sway {
    from { transform: translateX(-16px); }
    to { transform: translateX(16px); }
  }
  @keyframes sfx-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes sfx-flutter {
    from { transform: rotate(calc(var(--rot) - 7deg)) translateY(-3px); }
    to { transform: rotate(calc(var(--rot) + 7deg)) translateY(3px); }
  }
  @keyframes sfx-wingbeat {
    0%, 100% { transform: scaleX(var(--dir)) scaleY(1) rotate(0deg); }
    50% { transform: scaleX(var(--dir)) scaleY(0.74) rotate(calc(var(--dir) * 1deg)); }
  }
  @keyframes sfx-glow {
    from { transform: scale(0.92); filter: drop-shadow(0 0 4px rgba(250, 204, 21, 0.35)); }
    to { transform: scale(1.08); filter: drop-shadow(0 0 14px rgba(250, 204, 21, 0.75)); }
  }
  @keyframes sfx-sun {
    0% { opacity: 0; }
    8% { opacity: 1; }
    45% { opacity: 1; }
    58% { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes sfx-cross-r {
    from { transform: translateX(-22vw); }
    to { transform: translateX(122vw); }
  }
  @keyframes sfx-cross-l {
    from { transform: translateX(122vw); }
    to { transform: translateX(-22vw); }
  }
  @keyframes sfx-bob {
    from { transform: translateY(-9px) rotate(-5deg); }
    to { transform: translateY(9px) rotate(5deg); }
  }
  @keyframes sfx-out {
    to { opacity: 0; visibility: hidden; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sfx { display: none; }
  }
  @media print {
    .sfx { display: none; }
  }
</style>

<script>
  const sfx = document.querySelector('.sfx');
  if (sfx) setTimeout(() => sfx.remove(), 8000);
</script>
