---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const path = '/1-class/chtenie/razdatochnyy-material/';
---

<BaseLayout
  title="Слоги — раздаточный материал для 1 класса"
  description="Печатная брошюра А5 со слогами для обучения чтению в 1 классе: выбор согласных и гласных, схем слога, размера шрифта и фильтра нежелательных сочетаний. Печать A4→A5."
  keywords="слоги, чтение, 1 класс, раздаточный материал, брошюра А5, печать, обучение чтению"
  page="reading"
  crumbs={['Чтение', 'Слоги — раздаточный материал']}
  pairOverride={{ ru: path, en: path }}
>
  <section class="slogi-hero">
    <h1>Слоги — раздаточный материал</h1>
    <p>Брошюра А5 со слогами для тренировки чтения. Настройте буквы и схемы, сгенерируйте листы и распечатайте: лист А4, альбомная, двусторонняя печать, переворот по короткому краю. Разрезать или сложить пополам — получится брошюра А5.</p>
  </section>

  <section class="slogi-app" id="slogiApp">
    <header class="slogi-panel">
      <div class="slogi-field">
        <span>Согласные</span>
        <input type="text" id="consonants" value="БВГДЖЗКЛМНПРСТФХЦЧШЩ" spellcheck="false">
      </div>
      <div class="slogi-field">
        <span>Гласные</span>
        <input type="text" id="vowels" value="АОУЫЭИЯЁЮЕ" spellcheck="false">
      </div>
      <div class="slogi-field">
        <span>Схемы слога</span>
        <span class="slogi-checks">
          <label><input type="checkbox" id="pСССГ" checked> СССГ</label>
          <label><input type="checkbox" id="pССГС" checked> ССГС</label>
          <label><input type="checkbox" id="pСГСС"> СГСС</label>
          <label><input type="checkbox" id="pГССС"> ГССС</label>
        </span>
      </div>
      <div class="slogi-field">
        <span>Буквы не повторяются</span>
        <span class="slogi-checks"><label><input type="checkbox" id="noRepeat" checked> да</label></span>
      </div>
      <div class="slogi-field">
        <span>Слогов на страницу</span>
        <input type="number" id="perPage" value="40" min="4" max="120">
      </div>
      <div class="slogi-field">
        <span>Страниц</span>
        <input type="number" id="pages" value="12" min="4" step="4">
      </div>
      <div class="slogi-field">
        <span>Порядок</span>
        <select id="sort">
          <option value="shuffle" selected>вперемешку</option>
          <option value="alpha">по алфавиту</option>
        </select>
      </div>
      <div class="slogi-field">
        <span>Формат</span>
        <select id="modeSel">
          <option value="booklet" selected>брошюра А4→А5</option>
          <option value="simple">простые страницы А5</option>
        </select>
      </div>
      <div class="slogi-field">
        <span>Размер шрифта</span>
        <input type="range" id="fontSize" min="12" max="36" value="20">
      </div>
      <div class="slogi-field">
        <span>Шрифт слогов</span>
        <span class="slogi-inline">
          <select id="cellFont">
            <option value="" selected>Segoe UI</option>
            <option value="Arial">Arial</option>
            <option value="Georgia">Georgia</option>
            <option value="Times New Roman">Times New Roman</option>
            <option value="Verdana">Verdana</option>
            <option value="Tahoma">Tahoma</option>
            <option value="Trebuchet MS">Trebuchet MS</option>
            <option value="Calibri">Calibri</option>
            <option value="Cambria">Cambria</option>
            <option value="Comic Sans MS">Comic Sans MS</option>
            <option value="Segoe Print">Segoe Print</option>
            <option value="Segoe Script">Segoe Script</option>
            <option value="Courier New">Courier New</option>
          </select>
          <button class="slogi-mini" id="fontLoad" type="button" hidden title="Загрузить или обновить список установленных на компьютере шрифтов">Шрифты ПК</button>
        </span>
      </div>
      <div class="slogi-field">
        <span>Регистр</span>
        <select id="cellCase">
          <option value="uppercase" selected>ЗАГЛАВНЫЕ</option>
          <option value="lowercase">строчные</option>
        </select>
      </div>
      <div class="slogi-field">
        <span>Начертание</span>
        <select id="cellWeight">
          <option value="300">тонкие</option>
          <option value="600" selected>обычные</option>
          <option value="900">жирные</option>
        </select>
      </div>
      <div class="slogi-field slogi-field-wide">
        <span>Запрещённые сочетания (доп. корни через запятую)</span>
        <textarea id="badWords" spellcheck="false" placeholder="пусто — используется встроенный фильтр"></textarea>
      </div>
      <div class="slogi-checks slogi-panel-check">
        <label><input type="checkbox" id="showNums" checked> № страниц</label>
        <label><input type="checkbox" id="useBad" checked> фильтр нежелательных сочетаний</label>
      </div>
      <div class="slogi-actions">
        <button class="slogi-btn primary" id="btnGen" type="button">Сгенерировать</button>
        <button class="slogi-btn" id="btnPrint" type="button">Печать</button>
      </div>
    </header>

    <div class="slogi-note" id="info"></div>
    <div class="slogi-sheets" id="bookletView"></div>
    <div class="slogi-sheets hidden" id="simpleView"></div>
  </section>

  <style is:global>
    .slogi-hero{max-width:780px;margin:0 auto 14px;padding:0 4px}
    .slogi-hero h1{margin:0 0 8px;font-family:"Nunito","DM Sans","Segoe UI",Roboto,Arial,sans-serif;font-size:clamp(24px,3.4vw,34px);font-weight:900;color:#0f172a}
    .slogi-hero p{margin:0;font-size:14px;line-height:1.5;color:#475569;font-weight:600}
    .slogi-app{--line:#d8dde3;--ink:#1a1d21;--muted:#8a919a;--accent:#4338ca;--font-size:20px;--cell-weight:600;--cell-case:uppercase;max-width:1200px;width:100%;min-width:0;margin:0 auto}
    .slogi-app *{box-sizing:border-box}
    .slogi-panel{background:#fff;border:1px solid #e5e8f2;border-radius:18px;padding:14px 16px;display:flex;flex-wrap:wrap;gap:12px 18px;align-items:flex-end;box-shadow:0 16px 40px -34px rgba(15,23,42,.4)}
    .slogi-field{display:flex;flex-direction:column;gap:4px;font-size:11px;font-weight:800;letter-spacing:.02em;color:#64748b}
    .slogi-field input[type="text"],.slogi-field textarea{border:1.5px solid #e2e8f0;border-radius:9px;padding:6px 8px;font-size:13px;font-family:inherit;background:#fff;color:#0f172a}
    .slogi-field input[type="text"]{width:250px}
    .slogi-field input[type="number"],.slogi-field select{width:88px;border:1.5px solid #e2e8f0;border-radius:9px;padding:6px;font:inherit;background:#fff;color:#0f172a}
    .slogi-field-wide{flex:1 1 320px}
    .slogi-field textarea{width:100%;min-width:260px;height:34px;font-size:11px;resize:vertical}
    .slogi-checks{display:flex;flex-wrap:wrap;gap:10px;font-size:12px;font-weight:700;color:#334155}
    .slogi-checks label{display:flex;align-items:center;gap:5px;white-space:nowrap}
    .slogi-panel-check{flex-basis:100%}
    .slogi-actions{display:flex;gap:8px;margin-left:auto}
    .slogi-btn{border:2px solid #e5e8f2;border-radius:16px;padding:11px 20px;font-family:"Nunito","DM Sans","Segoe UI",Roboto,Arial,sans-serif;font-weight:900;font-size:14px;cursor:pointer;background:#fff;color:#334155;transition:border-color .12s,background .12s,filter .12s}
    .slogi-btn.primary{background:linear-gradient(135deg,#6366f1,#8b5cf6);border:0;color:#fff;box-shadow:0 14px 30px -14px rgba(99,102,241,.9)}
    .slogi-btn:not(.primary):hover{border-color:#c7d2fe;background:#f8f9ff}
    .slogi-btn.primary:hover{filter:brightness(1.05)}
    .slogi-inline{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
    .slogi-app #cellFont{width:190px}
    .slogi-mini{border:1.5px solid #e2e8f0;border-radius:9px;padding:6px 9px;font:inherit;font-weight:800;font-size:11px;background:#fff;color:#4338ca;cursor:pointer}
    .slogi-mini:hover{border-color:#c7d2fe;background:#f8f9ff}
    .slogi-note{font-size:12px;font-weight:700;color:#64748b;text-align:center;padding:10px 6px 0;line-height:1.45}
    .slogi-sheets{padding:16px 4px 34px;display:flex;flex-direction:column;align-items:center;gap:18px;overflow-x:auto;max-width:100%;min-width:0}
    .slogi-sheets.hidden{display:none !important}
    .slogi-sheets .side{width:297mm;height:210mm;background:#fff;box-shadow:0 2px 14px rgba(0,0,0,.14);display:flex;position:relative;flex-shrink:0}
    .slogi-sheets .pane{width:148mm;height:210mm;padding:10mm 9mm 8mm;position:relative;display:flex;flex-direction:column}
    .slogi-sheets .pane+.pane{border-left:1px dashed #b9c0c8}
    .slogi-sheets .pane-label{position:absolute;top:3mm;right:4mm;font-size:9px;color:var(--muted)}
    .slogi-sheets .pane.is-blank{background:repeating-linear-gradient(45deg,#f6f7f9,#f6f7f9 8px,#eef0f3 8px,#eef0f3 16px)}
    .slogi-sheets .pane.is-blank::after{content:"пустая страница";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:12px}
    .slogi-sheets .badge{position:absolute;top:2mm;left:3mm;background:rgba(67,56,202,.1);color:var(--accent);font-size:10px;padding:1px 7px;border-radius:3px}
    .slogi-sheets .grid{flex:1;display:grid;grid-template-columns:repeat(5,1fr);grid-auto-rows:1fr;gap:1.4mm 2mm;margin-top:6mm}
    .slogi-sheets .cell{display:flex;align-items:center;justify-content:center;font-size:var(--font-size);font-weight:var(--cell-weight,600);letter-spacing:.06em;line-height:1;text-transform:var(--cell-case,uppercase);font-family:var(--cell-font,"Segoe UI","PT Sans",Arial,sans-serif)}
    .slogi-sheets .cell:nth-child(5n):not(:last-child){border-right:1px solid var(--line)}
    .slogi-sheets .cell:not(:nth-child(5n)){border-right:1px solid var(--line)}
    .slogi-sheets .grid .cell{border-bottom:1px solid var(--line)}
    .slogi-sheets .grid .cell:nth-child(n+37){border-bottom:none}
    .slogi-sheets .a5page{width:148mm;height:210mm;background:#fff;box-shadow:0 2px 14px rgba(0,0,0,.14);padding:10mm 9mm 8mm;position:relative;flex-shrink:0}
    .slogi-sheets .a5page .pane-label{}
    @media (max-width:560px){
      .slogi-field input[type="text"]{width:100%}
      .slogi-field-wide{flex-basis:100%}
      .slogi-actions{margin-left:0;width:100%}
    }
  </style>
  <style is:inline id="printCss"></style>

  <script is:inline>
  "use strict";
  (function(){
    var $ = function (id) { return document.getElementById(id); };
    var MODE_BOOKLET = "booklet";
    var MODE_SIMPLE = "simple";
    var mode = MODE_BOOKLET;

    var BAD_DEFAULT = "хуй,хуя,хуе,хуё,хуи,хуев,хуес,пизд,ебл,еба,ебё,бля,муд,хер,залуп,жоп,елд,сса,ссё,сси,бзд,пид,сук," +
      "еб,заеб,наеб,уёб,трах,срак,перд,говн,шлюх,мраз,пидр,долб,далб,курв,гнид,порн,секс,чмо";

    var HIDE_CHROME = ".site-nav,.site-top,.slogi-hero,.slogi-panel,.slogi-note{display:none !important}" +
      ".site-main{padding:0 !important;max-width:none !important}" +
      ".site-shell{display:block !important}";

    var PRINT_CSS_BOOKLET =
      "@page{size:A4 landscape;margin:0}" +
      "@media print{body{margin:0;background:#fff}" + HIDE_CHROME +
      ".slogi-sheets{padding:0;gap:0;overflow:visible}" +
      ".slogi-sheets .side{box-shadow:none;page-break-after:always}" +
      ".slogi-sheets .side:last-child{page-break-after:auto}" +
      ".slogi-sheets .pane{break-inside:avoid}" +
      ".slogi-sheets .badge{display:none !important}" +
      ".slogi-sheets .cell{border-color:#ccd2d9}}";

    var PRINT_CSS_SIMPLE =
      "@page{size:A5 portrait;margin:0}" +
      "@media print{body{margin:0;background:#fff}" + HIDE_CHROME +
      ".slogi-sheets{padding:0;gap:0;overflow:visible}" +
      ".slogi-sheets .a5page{box-shadow:none;page-break-after:always}" +
      ".slogi-sheets .a5page:last-child{page-break-after:auto}}";

    function shuffle(arr) {
      for (var i = arr.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
      }
      return arr;
    }
    function permutations(arr, count) {
      var out = [];
      var n = arr.length;
      if (count === 1) {
        for (var i = 0; i < n; i++) out.push([arr[i]]);
        return out;
      }
      for (var i = 0; i < n; i++) {
        var rest = arr.slice(0, i).concat(arr.slice(i + 1));
        var sub = permutations(rest, count - 1);
        for (var j = 0; j < sub.length; j++) out.push([arr[i]].concat(sub[j]));
      }
      return out;
    }

    function badRoots() {
      if (!$("useBad").checked) return [];
      var extra = $("badWords").value.toLowerCase().split(/[,\s;]+/).filter(function (s) { return s.length > 0; });
      return BAD_DEFAULT.split(",").concat(extra);
    }

    function generateSyllables() {
      var cons = $("consonants").value.replace(/\s+/g, "").toUpperCase().split("");
      var vows = $("vowels").value.replace(/\s+/g, "").toUpperCase().split("");
      var noRepeat = $("noRepeat").checked;
      var patterns = [];
      if ($("pСССГ").checked) patterns.push("СССГ");
      if ($("pССГС").checked) patterns.push("ССГС");
      if ($("pСГСС").checked) patterns.push("СГСС");
      if ($("pГССС").checked) patterns.push("ГССС");
      var bad = badRoots();
      var set = {};
      var triples = noRepeat ? permutations(cons, 3) : null;
      function add(str) {
        if (bad.length) {
          var low = str.toLowerCase();
          if (bad.some(function (r) { return low.indexOf(r) !== -1; })) return;
        }
        set[str] = true;
      }
      function build(pat, a, b, c, v) {
        var out = "";
        var ci = 0;
        for (var i = 0; i < 4; i++) {
          if (pat.charAt(i) === "С") { out += (ci === 0 ? a : ci === 1 ? b : c); ci++; }
          else { out += v; }
        }
        return out;
      }
      for (var p = 0; p < patterns.length; p++) {
        var pat = patterns[p];
        if (noRepeat) {
          for (var t = 0; t < triples.length; t++) {
            var a = triples[t][0], b = triples[t][1], c = triples[t][2];
            for (var v = 0; v < vows.length; v++) add(build(pat, a, b, c, vows[v]));
          }
        } else {
          for (var i = 0; i < cons.length; i++) {
            for (var j = 0; j < cons.length; j++) {
              for (var k = 0; k < cons.length; k++) {
                for (var v2 = 0; v2 < vows.length; v2++) add(build(pat, cons[i], cons[j], cons[k], vows[v2]));
              }
            }
          }
        }
      }
      var all = Object.keys(set);
      if ($("sort").value === "alpha") all.sort(); else shuffle(all);
      return all;
    }

    function padPages(n) { var r = n % 4; return r === 0 ? n : n + (4 - r); }
    function imposition(pageCount) {
      var sheets = [], S = pageCount / 4;
      for (var i = 0; i < S; i++) {
        sheets.push({ front: [pageCount - 2 * i, 2 * i + 1], back: [2 * i + 2, pageCount - (2 * i + 1)] });
      }
      return sheets;
    }
    function makeGrid(syllables) {
      var grid = document.createElement("div");
      grid.className = "grid";
      for (var i = 0; i < syllables.length; i++) {
        var cell = document.createElement("div");
        cell.className = "cell";
        cell.textContent = syllables[i];
        grid.appendChild(cell);
      }
      return grid;
    }
    function makePane(pageNum, syllables, label) {
      var pane = document.createElement("div");
      pane.className = "pane" + (syllables.length === 0 ? " is-blank" : "");
      if (label) {
        var b = document.createElement("div");
        b.className = "badge";
        b.textContent = label;
        pane.appendChild(b);
      }
      if ($("showNums").checked && syllables.length > 0) {
        var n = document.createElement("div");
        n.className = "pane-label";
        n.textContent = pageNum;
        pane.appendChild(n);
      }
      if (syllables.length > 0) pane.appendChild(makeGrid(syllables));
      return pane;
    }
    function pickForPrint(all, need) {
      if ($("sort").value !== "alpha" || all.length <= need) return all.slice(0, need);
      var out = [], step = all.length / need;
      for (var i = 0; i < need; i++) out.push(all[Math.floor(i * step)]);
      return out;
    }
    function slicePage(all, pageNum, perPage) {
      var start = (pageNum - 1) * perPage;
      if (start >= all.length) return [];
      var part = all.slice(start, start + perPage);
      if ($("sort").value === "alpha") part.sort();
      return part;
    }
    function applyFontSize() {
      var fs = parseInt($("fontSize").value, 10) || 20;
      $("slogiApp").style.setProperty("--font-size", fs + "px");
    }
    function applyCellFont() {
      var name = $("cellFont").value;
      $("slogiApp").style.setProperty("--cell-font",
        name ? '"' + name + '", "Segoe UI", "PT Sans", Arial, sans-serif'
             : '"Segoe UI", "PT Sans", Arial, sans-serif');
    }
    function applyCellStyle() {
      $("slogiApp").style.setProperty("--cell-case", $("cellCase").value);
      $("slogiApp").style.setProperty("--cell-weight", $("cellWeight").value);
    }
    function renderBooklet(all) {
      var view = $("bookletView");
      view.innerHTML = "";
      var perPage = Math.max(4, parseInt($("perPage").value, 10) || 40);
      var wantPages = Math.max(4, parseInt($("pages").value, 10) || 12);
      var picked = pickForPrint(all, wantPages * perPage);
      var total = picked.length;
      var filledPages = Math.ceil(total / perPage);
      var realPages = Math.max(4, padPages(filledPages));
      var blank = realPages - filledPages;
      $("info").innerHTML = "Всего слогов после фильтра: <b>" + all.length +
        "</b> · страниц в брошюре: <b>" + realPages + "</b>" +
        (blank > 0 ? " (из них пустых: " + blank + ")" : "") +
        (total < all.length ? ($("sort").value === "alpha" ? " · по алфавиту, равномерно по всему списку" : " · показана выборка из " + total) : "") +
        "<br>Печать: лист А4, альбомная, двусторонняя, переворот по короткому краю. Разрезать или сложить пополам — получится брошюра А5.";
      var sheets = imposition(realPages);
      for (var i = 0; i < sheets.length; i++) {
        var sh = sheets[i];
        var front = document.createElement("div");
        front.className = "side";
        front.appendChild(makePane(sh.front[0], slicePage(picked, sh.front[0], perPage), "Лист " + (i + 1) + " · лицевая"));
        front.appendChild(makePane(sh.front[1], slicePage(picked, sh.front[1], perPage)));
        view.appendChild(front);
        var back = document.createElement("div");
        back.className = "side";
        back.appendChild(makePane(sh.back[0], slicePage(picked, sh.back[0], perPage), "Лист " + (i + 1) + " · оборотная"));
        back.appendChild(makePane(sh.back[1], slicePage(picked, sh.back[1], perPage)));
        view.appendChild(back);
      }
    }
    function renderSimple(all) {
      var view = $("simpleView");
      view.innerHTML = "";
      var perPage = Math.max(4, parseInt($("perPage").value, 10) || 40);
      var wantPages = Math.max(1, parseInt($("pages").value, 10) || 12);
      var picked = pickForPrint(all, wantPages * perPage);
      var filledPages = Math.max(1, Math.ceil(picked.length / perPage));
      $("info").innerHTML = "Режим «простые страницы А5»: печать на бумаге А5 (или А4 с масштабированием). Страниц: <b>" +
        filledPages + "</b> из " + all.length + " слогов.";
      for (var p = 1; p <= filledPages; p++) {
        var page = document.createElement("div");
        page.className = "a5page";
        if ($("showNums").checked) {
          var n = document.createElement("div");
          n.className = "pane-label";
          n.textContent = p;
          page.appendChild(n);
        }
        page.appendChild(makeGrid(slicePage(picked, p, perPage)));
        view.appendChild(page);
      }
    }
    function render() {
      applyFontSize();
      applyCellFont();
      applyCellStyle();
      var all = generateSyllables();
      if (mode === MODE_BOOKLET) {
        $("bookletView").classList.remove("hidden");
        $("simpleView").classList.add("hidden");
        renderBooklet(all);
      } else {
        $("bookletView").classList.add("hidden");
        $("simpleView").classList.remove("hidden");
        renderSimple(all);
      }
    }
    function setMode(m) {
      mode = m;
      $("printCss").textContent = (m === MODE_BOOKLET) ? PRINT_CSS_BOOKLET : PRINT_CSS_SIMPLE;
      render();
    }

    $("btnGen").addEventListener("click", render);
    $("btnPrint").addEventListener("click", function () { window.print(); });
    $("modeSel").addEventListener("change", function (e) { setMode(e.target.value); });
    $("cellFont").addEventListener("change", applyCellFont);
    $("cellCase").addEventListener("change", applyCellStyle);
    $("cellWeight").addEventListener("change", applyCellStyle);
    var fontLoad = $("fontLoad");
    if (window.queryLocalFonts) {
      fontLoad.hidden = false;
      fontLoad.addEventListener("click", function () {
        window.queryLocalFonts().then(function (fonts) {
          var seen = {};
          for (var i = 0; i < fonts.length; i++) seen[fonts[i].family] = true;
          var fams = Object.keys(seen).sort(function (a, b) { return a.localeCompare(b, "ru"); });
          var sel = $("cellFont"), cur = sel.value;
          sel.innerHTML = '<option value="">Segoe UI</option>';
          for (var j = 0; j < fams.length; j++) {
            var o = document.createElement("option");
            o.value = fams[j]; o.textContent = fams[j];
            sel.appendChild(o);
          }
          sel.value = cur;
        }).catch(function () {});
      });
    }
    setMode(MODE_BOOKLET);
  })();
  </script>
</BaseLayout>
