---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/examples.css';

const B = import.meta.env.BASE_URL;
const asset = (p: string) => B.replace(/\/+$/, '') + '/' + p.replace(/^\/+/, '');
const jsVersion = Date.now().toString(36);
---

<BaseLayout title="Раздаточный материал — примеры для печати">
<div class="toolbar">
  <label class="fld">Рядов
    <input id="rows" type="number" min="2" max="40" value="8">
  </label>
  <label class="fld">Столбцов
    <input id="cols" type="number" min="2" max="10" value="3">
  </label>
  <label class="fld">Страниц с примерами
    <input id="pages" type="number" min="1" max="12" value="1">
  </label>
  <label class="fld">Считать от
    <input id="from" type="number" min="0" max="100" value="0">
  </label>
  <label class="fld">до
    <input id="limit" type="number" min="1" max="100" value="18">
  </label>
  <label class="chk" title="Только примеры с переходом через десяток">
    <input id="carry" type="checkbox" checked> с переходом через 10
  </label>
  <div class="fld">Действия
    <div class="ops" id="ops" role="group" aria-label="Действия">
      <label title="Сложение"><input type="checkbox" value="add" checked aria-label="Сложение"> +</label>
      <label title="Вычитание"><input type="checkbox" value="sub" checked aria-label="Вычитание"> −</label>
      <label title="Умножение"><input type="checkbox" value="mul" aria-label="Умножение"> ×</label>
      <label title="Деление"><input type="checkbox" value="div" aria-label="Деление"> ÷</label>
    </div>
  </div>
  <label class="fld">Что пропущено
    <select id="miss">
      <option value="r">Только ответ</option>
      <option value="a">Только первое число</option>
      <option value="b">Только второе число</option>
      <option value="ra">Ответ и первое число</option>
      <option value="rb">Ответ и второе число</option>
      <option value="ab">Первое и второе число</option>
      <option value="all">Все три вида</option>
    </select>
  </label>
  <label class="fld">Ответы
    <select id="ans">
      <option value="none">Без ответов</option>
      <option value="faint">Ответы серым (для проверки)</option>
      <option value="key">Отдельный лист-ключ</option>
    </select>
  </label>
  <label class="fld">Ключ варианта
    <input id="seed" type="number" min="1" value="1234">
  </label>
  <button id="again" class="btn" type="button">Другой вариант</button>
  <a class="btn" href={asset('offline/razdatochnyy-material.html')} download="razdatochnyy-material.html" data-offline-hide>Скачать офлайн</a>
  <button id="print" class="btn primary" type="button">Печать</button>
  <button id="sheet-help" class="btn help-btn" type="button" aria-expanded="false" aria-controls="sheet-help-panel">Инструкция</button>
  <div id="sheet-help-panel" class="help-panel" hidden>
    <h2>Как печатать</h2>
    <p>Печатайте на A4, масштаб 100 %, поля по умолчанию.</p>
    <p>Шрифт подстраивается под плотность; при 40×10 он будет мелким. В больших вариантах примеры могут повторяться.</p>
    <p>Для ×/÷ «от/до» — это произведение или делимое; множители и делители 1–10. С двумя пропусками возможны несколько решений.</p>
  </div>
</div>

<div id="sheets"></div>
<script is:inline src={asset('js/examples-logic.js') + '?v=' + jsVersion}></script>
<script is:inline src={asset('js/examples-ui.js') + '?v=' + jsVersion}></script>
</BaseLayout>
