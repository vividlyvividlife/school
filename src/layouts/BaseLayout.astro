---
import '../styles/site.css';
import NavTree from '../components/NavTree.astro';
import YandexMetrika from '../components/YandexMetrika.astro';
import { findTrail, navigation, normalizePath } from '../data/navigation';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  page?: string;
  crumbs?: string[];
  noindex?: boolean;
}

const { title, description, keywords, page, crumbs, noindex = false } = Astro.props;
const B = import.meta.env.BASE_URL;
const url = (path = '') => B.replace(/\/+$/, '') + '/' + path.replace(/^\/+/, '');

const basePath = B.replace(/\/+$/, '');
let route = Astro.url.pathname;
if (basePath && (route === basePath || route.startsWith(basePath + '/'))) {
  route = route.slice(basePath.length);
}
const current = normalizePath(route);
const trail = findTrail(navigation, current) ?? [];
const active = trail[trail.length - 1];
const crumbLabels = crumbs ?? (
  trail.length
    ? trail.map((item) => item.label)
    : current === '/'
      ? []
      : [title.split(' — ')[0]]
);
const pageKind = page ?? active?.page ?? 'home';

const siteName = 'Учебные материалы';
const defaultDescriptions: Record<string, string> = {
  home: 'Учебные материалы для начальной школы: тренажёр по математике и раздаточные материалы для 2 класса.',
  trainer: 'Тренажёр по математике для 2 класса: сложение, вычитание, умножение и деление. Настройте диапазон, перенос через десяток и режим тренировки.',
  examples: 'Раздаточный материал по математике для 2 класса: примеры на сложение, вычитание, умножение и деление для печати на A4.'
};
const desc = description || defaultDescriptions[pageKind] || `Учебные материалы: ${title}.`;
const keywordList = keywords || '2 класс, математика, начальная школа, тренажёр по математике, примеры по математике, раздаточный материал, сложение, вычитание, умножение, деление, печать, офлайн';
const site = Astro.site ?? new URL('https://example.github.io');
const rawPath = Astro.url.pathname || '/';
const canonicalPath = basePath && !(rawPath === basePath || rawPath.startsWith(basePath + '/'))
  ? basePath + (rawPath.startsWith('/') ? rawPath : `/${rawPath}`)
  : rawPath;
const canonical = new URL(canonicalPath, site).href;
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
const googlebot = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const ogType = pageKind === 'home' ? 'website' : 'article';
const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': pageKind === 'home' ? 'WebSite' : 'LearningResource',
  name: title,
  description: desc,
  url: canonical,
  inLanguage: 'ru'
};
if (pageKind !== 'home') {
  schema.isAccessibleForFree = true;
  schema.learningResourceType = pageKind === 'trainer' ? 'Тренажёр' : 'Раздаточный материал';
  schema.educationalLevel = '2 класс';
  schema.about = { '@type': 'Thing', name: 'Математика' };
  schema.audience = { '@type': 'EducationalAudience', educationalRole: 'student' };
}
---

<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#0f766e" />
  <meta name="color-scheme" content="light" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <meta name="keywords" content={keywordList} />
  <meta name="author" content={siteName} />
  <meta name="robots" content={robots} />
  <meta name="googlebot" content={googlebot} />
  <meta name="yandex" content={robots} />
  <meta name="bingbot" content={robots} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="ru" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={desc} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
</head>
<body data-page={pageKind}>
  <div class="site-shell">
    <aside id="siteNav" class="site-nav" aria-label="Боковое меню">
      <div class="site-navhead">
        <a class="site-brand" href={url('')}>
          <span class="logo" aria-hidden="true">∑</span>
          <span>Учебные материалы</span>
        </a>
        <button class="site-close" id="navClose" type="button" aria-label="Закрыть меню">×</button>
      </div>

      <nav aria-label="Меню разделов">
        <NavTree items={navigation} current={current} />
      </nav>
    </aside>

    <div class="site-main">
      <div class="site-top">
        <button
          class="site-navbtn"
          id="navToggle"
          type="button"
          aria-expanded="false"
          aria-controls="siteNav"
          aria-label="Открыть меню"
        >
          <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>Меню</span>
        </button>

        <nav class="site-crumbs" aria-label="Хлебные крошки">
          {crumbLabels.length === 0 ? (
            <span aria-current="page">Главная</span>
          ) : (
            <>
              <a href={url('')}>Главная</a>
              {crumbLabels.map((crumb, i) => (
                <>
                  <span class="sep" aria-hidden="true">/</span>
                  {i === crumbLabels.length - 1 ? <span aria-current="page">{crumb}</span> : <span>{crumb}</span>}
                </>
              ))}
            </>
          )}
        </nav>
      </div>

      <div class="site-content">
        <slot />
      </div>
    </div>
  </div>

  <div id="navScrim" class="site-scrim"></div>

  <script>
    (function () {
      var body = document.body;
      var btn = document.getElementById('navToggle');
      var close = document.getElementById('navClose');
      var scrim = document.getElementById('navScrim');
      var nav = document.getElementById('siteNav');
      if (!btn) return;

      function set(open) {
        body.classList.toggle('site-nav-open', open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
        if (open && close) close.focus();
        else btn.focus();
      }

      btn.addEventListener('click', function () {
        set(!body.classList.contains('site-nav-open'));
      });
      if (close) close.addEventListener('click', function () { set(false); });
      if (scrim) scrim.addEventListener('click', function () { set(false); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && body.classList.contains('site-nav-open')) set(false);
      });
      if (nav) {
        nav.addEventListener('click', function (e) {
          if (e.target.closest && e.target.closest('a')) set(false);
        });
      }
    })();
  </script>
  <YandexMetrika />
</body>
</html>
