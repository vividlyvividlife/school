---
import '../styles/site.css';
import NavTree from '../components/NavTree.astro';
import YandexMetrika from '../components/YandexMetrika.astro';
import { findTrail, navigationByLang, normalizePath } from '../data/navigation';
import { siteCopy, type Lang } from '../i18n/site';
import { pagePairFor } from '../i18n/routes';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  page?: string;
  crumbs?: string[];
  noindex?: boolean;
  lang?: Lang;
}

const { title, description, keywords, page, crumbs, noindex = false, lang = 'ru' } = Astro.props;
const c = siteCopy[lang];
const otherLang: Lang = lang === 'ru' ? 'en' : 'ru';
const B = import.meta.env.BASE_URL;
const url = (path = '') => B.replace(/\/+$/, '') + '/' + path.replace(/^\/+/, '');

const basePath = B.replace(/\/+$/, '');
let route = Astro.url.pathname;
if (basePath && (route === basePath || route.startsWith(basePath + '/'))) {
  route = route.slice(basePath.length);
}
const current = normalizePath(route);
const navItems = navigationByLang[lang];
const trail = findTrail(navItems, current) ?? [];
const active = trail[trail.length - 1];
const crumbLabels = crumbs ?? (
  trail.length
    ? trail.map((item) => item.label)
    : current === '/' || current === '/en/'
      ? []
      : [title.split(' — ')[0]]
);
const pageKind = page ?? active?.page ?? 'home';
const pageMeta = pageKind === 'trainer'
  ? c.trainerPage
  : pageKind === 'examples'
    ? c.worksheetPage
    : pageKind === 'reading'
      ? c.readingPage
      : c.homePage;
const desc = description || pageMeta.description;
const keywordList = keywords || pageMeta.keywords;
const site = Astro.site ?? new URL('https://example.github.io');
const abs = (path: string) => new URL(`${basePath}${path}`, site).href;
const canonical = abs(current);
const pair = pagePairFor(current);
const ruUrl = abs(pair.ru);
const enUrl = abs(pair.en);
const switchTarget = lang === 'ru' ? pair.en : pair.ru;
const ogImage = abs(lang === 'en' ? '/og/site-preview-en.jpg' : '/og/site-preview-ru.jpg');
const ogImageAlt = lang === 'en'
  ? 'Learning Materials — Grade 2: math and Belarusian language'
  : 'Учебные материалы — 2 класс: математика и беларуская мова';
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
const googlebot = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const ogType = pageKind === 'home' ? 'website' : 'article';
const resourceType = pageKind === 'trainer'
  ? (lang === 'ru' ? 'Тренажёр' : 'Trainer')
  : pageKind === 'reading'
    ? (lang === 'ru' ? 'Материалы для чтения' : 'Reading materials')
    : (lang === 'ru' ? 'Раздаточный материал' : 'Worksheet');
const educationalLevel = lang === 'ru' ? '2 класс' : 'Grade 2';
const subject = pageKind === 'reading'
  ? (lang === 'ru' ? 'Беларуская мова' : 'Belarusian')
  : (lang === 'ru' ? 'Математика' : 'Mathematics');
const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': pageKind === 'home' ? 'WebSite' : 'LearningResource',
  name: title,
  description: desc,
  url: canonical,
  image: ogImage,
  inLanguage: lang
};
if (pageKind !== 'home') {
  schema.isAccessibleForFree = true;
  schema.learningResourceType = resourceType;
  schema.educationalLevel = educationalLevel;
  schema.about = { '@type': 'Thing', name: subject };
  schema.audience = { '@type': 'EducationalAudience', educationalRole: 'student' };
}
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#0f766e" />
  <meta name="color-scheme" content="light dark" />
  <script is:inline>
    (function () {
      var saved = null;
      try { saved = localStorage.getItem('theme'); } catch (e) {}
      var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', dark ? '#0b1220' : '#0f766e');
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <meta name="keywords" content={keywordList} />
  <meta name="author" content={c.siteName} />
  <meta name="robots" content={robots} />
  <meta name="googlebot" content={googlebot} />
  <meta name="yandex" content={robots} />
  <meta name="bingbot" content={robots} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="ru" href={ruUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={ruUrl} />
  <link rel="sitemap" type="application/xml" href={url('sitemap.xml')} />
  <meta property="og:locale" content={c.locale} />
  <meta property="og:locale:alternate" content={c.localeAlternate} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={c.siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
</head>
<body data-page={pageKind} data-lang={lang}>
  <div class="site-shell">
    <aside id="siteNav" class="site-nav" aria-label={c.sidebar}>
      <div class="site-navhead">
        <a class="site-brand" href={url(lang === 'en' ? 'en/' : '')}>
          <span class="logo" aria-hidden="true">∑</span>
          <span>{c.siteName}</span>
        </a>
        <button class="site-close" id="navClose" type="button" aria-label={c.closeMenu}>×</button>
      </div>

      <nav aria-label={c.sections}>
        <NavTree items={navItems} current={current} />
      </nav>
    </aside>

    <div class="site-main">
      <div class="site-top">
        <button
          class="site-navbtn"
          id="navToggle"
          type="button"
          aria-expanded="false"
          aria-controls="siteNav"
          aria-label={c.openMenu}
          data-label-open={c.openMenu}
          data-label-close={c.closeMenu}
        >
          <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>{c.menu}</span>
        </button>

        <nav class="site-crumbs" aria-label={c.breadcrumbs}>
          {crumbLabels.length === 0 ? (
            <span aria-current="page">{c.homeLabel}</span>
          ) : (
            <>
              <a href={url(lang === 'en' ? 'en/' : '')}>{c.homeLabel}</a>
              {crumbLabels.map((crumb, i) => (
                <>
                  <span class="sep" aria-hidden="true">/</span>
                  {i === crumbLabels.length - 1 ? <span aria-current="page">{crumb}</span> : <span>{crumb}</span>}
                </>
              ))}
            </>
          )}
        </nav>

        <button
          class="site-theme"
          id="themeToggle"
          type="button"
          aria-label={c.themeDark}
          title={c.themeDark}
          data-label-dark={c.themeDark}
          data-label-light={c.themeLight}
        >
          <svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" /></svg>
          <svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
        </button>

        <a
          class="site-lang"
          href={url(switchTarget)}
          hreflang={otherLang}
          lang={otherLang}
          aria-label={`${c.language}: ${c.switchTo}`}
          title={c.switchTo}
        >{c.switchCode}</a>
      </div>

      <div class="site-content">
        <slot />
      </div>
    </div>
  </div>

  <div id="navScrim" class="site-scrim"></div>

  <script>
    (function () {
      var body = document.body;
      var btn = document.getElementById('navToggle');
      var close = document.getElementById('navClose');
      var scrim = document.getElementById('navScrim');
      var nav = document.getElementById('siteNav');
      if (!btn) return;
      var openLabel = btn.getAttribute('data-label-open') || '';
      var closeLabel = btn.getAttribute('data-label-close') || '';

      function set(open) {
        body.classList.toggle('site-nav-open', open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.setAttribute('aria-label', open ? closeLabel : openLabel);
        if (open && close) close.focus();
        else btn.focus();
      }

      btn.addEventListener('click', function () {
        set(!body.classList.contains('site-nav-open'));
      });
      if (close) close.addEventListener('click', function () { set(false); });
      if (scrim) scrim.addEventListener('click', function () { set(false); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && body.classList.contains('site-nav-open')) set(false);
      });
      if (nav) {
        nav.addEventListener('click', function (e) {
          if (e.target.closest && e.target.closest('a')) set(false);
        });
      }
    })();
  </script>

  <script>
    (function () {
      var root = document.documentElement;
      var btn = document.getElementById('themeToggle');
      if (!btn) return;
      var media = window.matchMedia('(prefers-color-scheme: dark)');
      var darkLabel = btn.getAttribute('data-label-dark') || '';
      var lightLabel = btn.getAttribute('data-label-light') || '';
      var meta = document.querySelector('meta[name="theme-color"]');

      function stored() {
        try { return localStorage.getItem('theme'); } catch (e) { return null; }
      }

      function apply(theme) {
        var dark = theme === 'dark';
        root.setAttribute('data-theme', dark ? 'dark' : 'light');
        btn.setAttribute('aria-label', dark ? lightLabel : darkLabel);
        btn.setAttribute('title', dark ? lightLabel : darkLabel);
        btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
        if (meta) meta.setAttribute('content', dark ? '#0b1220' : '#0f766e');
      }

      btn.addEventListener('click', function () {
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        apply(next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
      media.addEventListener('change', function (e) {
        if (!stored()) apply(e.matches ? 'dark' : 'light');
      });
      window.addEventListener('storage', function (e) {
        if (e.key === 'theme') apply(e.newValue === 'dark' ? 'dark' : 'light');
      });
      apply(root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');
    })();
  </script>
  <YandexMetrika />
</body>
</html>
